@page "/reception/{IdPublic:guid}"
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject UtilisateurCourant Courant
@inject ServiceMouvements Mouvements

<PageTitle>Confirmation de réception</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="px-0">
    @if (_chargement)
    {
        <Attente />
    }
    else if (_fiche is null)
    {
        <MudAlert Severity="Severity.Error">Ce lien de confirmation n'est pas valide.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-1">Réception de matériel</MudText>
        <MudText Class="mb-6" Style="color:var(--mud-palette-text-secondary)">Fiche @_fiche.Code – envoyée à @_fiche.DestinataireNom</MudText>

        @if (_erreur is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_erreur</MudAlert>
        }

        <MudPaper Elevation="0" Class="carte pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Matériel envoyé</MudText>
            <MudSimpleTable Dense="true" Elevation="0">
                <thead><tr><th>N° interne</th><th>Type</th><th>Modèle</th><th>N° de série</th></tr></thead>
                <tbody>
                    @foreach (var m in _fiche.Mouvements.OrderBy(m => m.Numero))
                    {
                        <tr><td><b>@m.Materiel.NumInterne</b></td><td>@m.Materiel.Type.Libelle()</td><td>@m.Materiel.Modele</td><td>@m.Materiel.NumSerie</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>

        @switch (_fiche.StatutReception)
        {
            case StatutReception.EnAttente when _autorise:
                <MudPaper Elevation="0" Class="carte pa-4">
                    <MudText Class="mb-3">En confirmant, vous attestez avoir reçu le matériel ci-dessus en bon état.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="Confirmer" Disabled="_envoi">Je confirme la réception</MudButton>
                    @if (!_u!.AEmail(_fiche.DestinataireEmail))
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-2">
                            Vous êtes connecté en tant que service informatique : la confirmation sera enregistrée pour le compte de @_fiche.DestinataireEmail.
                        </MudText>
                    }
                </MudPaper>
                break;
            case StatutReception.EnAttente:
                <MudAlert Severity="Severity.Warning">
                    Cette confirmation est réservée à <b>@_fiche.DestinataireEmail</b>. Vous êtes connecté en tant que @_u!.Email.
                </MudAlert>
                break;
            case StatutReception.Confirmee:
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    Réception confirmée le @_fiche.ReceptionConfirmeeLe?.ToLocalTime().ToString("dd/MM/yyyy à HH:mm") par @_fiche.ReceptionConfirmeePar. Merci !
                </MudAlert>
                @if (_autorise)
                {
                    var pcs = _fiche.Mouvements.Where(m => m.Materiel.EstUnPc && m.Materiel.MotDePasseSession != null && _toujoursDetenus.Contains(m.Id)).ToList();
                    @if (pcs.Count > 0)
                    {
                        <MudPaper Elevation="0" Class="carte pa-4 mb-4">
                            <MudText Typo="Typo.h6" Class="mb-2">Mot de passe de session</MudText>
                            @foreach (var m in pcs)
                            {
                                <div class="d-flex align-center gap-3 my-1">
                                    <b>@m.Materiel.NumInterne</b>
                                    @if (_motsDePasseVisibles)
                                    {
                                        <span class="mot-de-passe">@m.Materiel.MotDePasseSession</span>
                                    }
                                </div>
                            }
                            @if (!_motsDePasseVisibles)
                            {
                                <MudButton Class="mt-2" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Visibility" OnClick="AfficherMotsDePasse">Afficher le mot de passe</MudButton>
                            }
                        </MudPaper>
                    }
                    <MudButton Href="@($"/fiches/{_fiche.IdPublic}/pdf")" Target="_blank" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.PictureAsPdf">Télécharger la fiche d'attribution</MudButton>
                }
                break;
            default:
                <MudAlert Severity="Severity.Info">Cette fiche ne nécessite pas de confirmation de réception.</MudAlert>
                break;
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid IdPublic { get; set; }

    private bool _chargement = true;
    private bool _envoi;
    private bool _autorise;
    private bool _motsDePasseVisibles;
    private string? _erreur;
    private Fiche? _fiche;
    private Utilisateur? _u;
    /// <summary>Mouvements de la fiche qui sont toujours le dernier mouvement de leur matériel (matériel pas réattribué depuis).</summary>
    private HashSet<int> _toujoursDetenus = [];

    protected override async Task OnParametersSetAsync()
    {
        _u = await Courant.ObtenirAsync();
        await Charger();
        _chargement = false;
    }

    private async Task Charger()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _fiche = await ServiceMouvements.ChargerFiche(db).AsNoTracking().FirstOrDefaultAsync(f => f.IdPublic == IdPublic);
        _autorise = _fiche is not null && (_u!.AEmail(_fiche.DestinataireEmail) || _u.EstGestionnaire);
        if (_fiche is null) return;
        var ids = _fiche.Mouvements.Select(m => m.MaterielId).ToList();
        var derniers = await db.Mouvements.Where(m => ids.Contains(m.MaterielId))
            .GroupBy(m => m.MaterielId).Select(g => g.Max(m => m.Numero)).ToListAsync();
        _toujoursDetenus = _fiche.Mouvements.Where(m => derniers.Contains(m.Numero) && m.Materiel.Statut == StatutMateriel.Attribue).Select(m => m.Id).ToHashSet();
    }

    private async Task Confirmer()
    {
        _envoi = true;
        _erreur = null;
        try
        {
            await Mouvements.ConfirmerReceptionAsync(IdPublic, _u!);
            await Charger();
        }
        catch (ErreurMetier ex) { _erreur = ex.Message; }
        finally { _envoi = false; }
    }

    private async Task AfficherMotsDePasse()
    {
        _motsDePasseVisibles = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Journal.Add(new Journal { Date = DateTime.UtcNow, Utilisateur = _u!.Signature, Action = "Mot de passe affiché", Details = $"Fiche {_fiche!.Code}" });
        await db.SaveChangesAsync();
    }
}
