@page "/tickets/{Id:int}"
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject ServiceTickets Service
@inject UtilisateurCourant Courant
@inject ISnackbar Snackbar

<PageTitle>Ticket @(_t?.Numero)</PageTitle>

@if (_chargement)
{
    <Attente />
}
else if (_t is null || !ServiceTickets.PeutVoir(_u!, _t))
{
    <MudAlert Severity="Severity.Error">Ticket introuvable ou accès non autorisé.</MudAlert>
}
else
{
    <MudBreadcrumbs Items="@([_u!.EstAdminTickets ? new("Tickets", "/tickets") : new("Mes tickets", "/mes-tickets"), new($"n° {_t.Numero}", null, true)])" Class="px-0 pt-0" />
    <div class="d-flex flex-wrap align-center gap-3 mb-1">
        <MudText Typo="Typo.h4">Ticket n° @_t.Numero</MudText>
        <ChipTicket Statut="_t.Statut" />
        @if (_u.EstAdminTickets) { <ChipTicket Priorite="_t.Priorite" /> }
    </div>
    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight:400">@_t.Titre</MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Class="carte pa-4 mb-3">
                <MudText Typo="Typo.caption">Ouvert le @_t.CreeLe.ToLocalTime().ToString("dd/MM/yyyy à HH:mm") (saisi par @_t.SaisiePar)</MudText>
                <dl class="champ-lecture">
                    <Champ Libelle="Type de problème" Valeur="@_t.Categorie.Libelle()" />
                    <Champ Libelle="Description" Valeur="@_t.Description" />
                    <Champ Libelle="Impact" Valeur="@_t.Impact.Libelle()" />
                    <Champ Libelle="Personnes concernées" Valeur="@_t.Portee.Libelle()" />
                    <Champ Libelle="Matériel concerné">
                        @if (_t.Materiel is { } m && _u.EstGestionnaire)
                        {
                            <MudLink Href="@($"/materiels/{m.Id}")">@m.NumInterne</MudLink> <span>– @m.Type.Libelle() @m.Modele</span>
                        }
                        else if (_t.Materiel is { } m2)
                        {
                            <span>@m2.NumInterne – @m2.Type.Libelle() @m2.Modele</span>
                        }
                        else
                        {
                            @(_t.MaterielReference ?? "")
                            @if (_t.MaterielReference is not null && _u.EstAdminTickets) { <MudText Typo="Typo.caption" Style="color:var(--mud-palette-warning)"> (absent de l'inventaire)</MudText> }
                        }
                    </Champ>
                    <Champ Libelle="Déjà essayé" Valeur="@_t.DejaEssaye" />
                    <Champ Libelle="Site / service" Valeur="@_t.Lieu" />
                    <Champ Libelle="Demandeur" Valeur="@_t.DemandeurNom" />
                    <Champ Libelle="Mail"><a href="mailto:@_t.DemandeurEmail">@_t.DemandeurEmail</a></Champ>
                    <Champ Libelle="Téléphone"><a href="tel:@_t.DemandeurTelephone">@_t.DemandeurTelephone</a></Champ>
                    <Champ Libelle="Disponibilités" Valeur="@_t.Disponibilites" />
                </dl>
            </MudPaper>

            <MudPaper Elevation="0" Class="carte pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Échanges</MudText>
                <MudStack Spacing="2">
                    @foreach (var msg in Messages)
                    {
                        <div class="@ClasseMessage(msg)">
                            @if (msg.Systeme)
                            {
                                <span>@msg.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @msg.Texte · @msg.Auteur</span>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">
                                    <b>@msg.Auteur</b> · @msg.Date.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")
                                    @if (msg.Interne) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="my-0">Note interne</MudChip> }
                                </MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@msg.Texte</MudText>
                            }
                        </div>
                    }
                    @if (!Messages.Any())
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">Aucun échange pour l'instant.</MudText>
                    }
                </MudStack>
                @if (_t.Statut != StatutTicket.Clos)
                {
                    <MudTextField @bind-Value="_message" MaxLength="4000" Label="@(_interne ? "Note interne (invisible du demandeur)" : "Votre message")" Lines="3"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />
                    <div class="d-flex flex-wrap align-center gap-2 mt-2">
                        @if (_u.EstAdminTickets)
                        {
                            <MudSwitch T="bool" @bind-Value="_interne" Color="Color.Warning" Label="Note interne" />
                        }
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Envoyer" Disabled="_envoi" StartIcon="@Icons.Material.Outlined.Send">Envoyer</MudButton>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            @* --- Confirmation par le demandeur --- *@
            @if (_t.Statut == StatutTicket.Resolu && ServiceTickets.EstDemandeur(_u, _t))
            {
                <MudPaper Elevation="0" Class="carte pa-4 mb-3" Style="border-color:var(--mud-palette-success)">
                    <MudText Typo="Typo.h6" Class="mb-1">Le problème est-il réglé ?</MudText>
                    @if (_t.Solution is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mb-3" Style="white-space:pre-line"><b>Solution apportée :</b> @_t.Solution</MudText>
                    }
                    <MudText Typo="Typo.body2">Votre avis sur la réponse apportée :</MudText>
                    <MudRating @bind-SelectedValue="_note" MaxValue="5" Size="Size.Large" Class="mb-2" />
                    <MudTextField @bind-Value="_avis" MaxLength="2000" Label="Commentaire ou explication si le problème persiste" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Confirmer" Disabled="_envoi" StartIcon="@Icons.Material.Filled.Check">Oui, c'est réglé</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Persiste" Disabled="_envoi">Non, le problème persiste</MudButton>
                    </div>
                </MudPaper>
            }

            @if (_u.EstAdminTickets)
            {
                <MudPaper Elevation="0" Class="carte pa-4 mb-3">
                    <MudText Typo="Typo.h6" Class="mb-2">Traitement</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_m.Statut" Label="Statut" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var s in Enum.GetValues<StatutTicket>()) { <MudSelectItem Value="s">@s.Libelle()</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_m.Priorite" Label="Priorité" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       HelperText="@($"Proposée : {Ticket.PrioriteProposee(_t.Impact, _t.Portee).Libelle()}")">
                                @foreach (var p in Enum.GetValues<PrioriteTicket>()) { <MudSelectItem Value="p">@p.Libelle()</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_m.Categorie" Label="Catégorie" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var c in Enum.GetValues<CategorieTicket>()) { <MudSelectItem Value="c">@c.Libelle()</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_m.MaterielReference" MaxLength="60" Label="N° interne du matériel" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Error="@(Err(nameof(MiseAJourTicket.MaterielReference)) is not null)" ErrorText="@Err(nameof(MiseAJourTicket.MaterielReference))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_m.AssigneA" MaxLength="200" Label="Pris en charge par" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.PersonAdd" AdornmentAriaLabel="M'attribuer le ticket"
                                          OnAdornmentClick="() => _m.AssigneA = _u.Nom" HelperText="Icône : vous attribuer le ticket" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Class="carte pa-4 mb-3">
                    <MudText Typo="Typo.h6" Class="mb-1">Analyse et résolution</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-2">Cause, solution et mode de résolution sont obligatoires pour passer le ticket à « Résolu » ou « Clos ».</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_m.Diagnostic" MaxLength="4000" Label="Diagnostic (ce qui a été constaté)" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="CauseTicket?" @bind-Value="_m.Cause" Label="Cause" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                       Error="@(Err(nameof(MiseAJourTicket.Cause)) is not null)" ErrorText="@Err(nameof(MiseAJourTicket.Cause))">
                                @foreach (var c in Enum.GetValues<CauseTicket>()) { <MudSelectItem T="CauseTicket?" Value="c">@c.Libelle()</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="ModeResolution?" @bind-Value="_m.ModeResolution" Label="Mode de résolution" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                       Error="@(Err(nameof(MiseAJourTicket.ModeResolution)) is not null)" ErrorText="@Err(nameof(MiseAJourTicket.ModeResolution))">
                                @foreach (var r in Enum.GetValues<ModeResolution>()) { <MudSelectItem T="ModeResolution?" Value="r">@r.Libelle()</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_m.Solution" MaxLength="4000" Label="Solution apportée (visible par le demandeur)" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Error="@(Err(nameof(MiseAJourTicket.Solution)) is not null)" ErrorText="@Err(nameof(MiseAJourTicket.Solution))" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int?" @bind-Value="_m.TempsPasseMinutes" Label="Temps passé (min)" Min="0" Max="100000" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Error="@(Err(nameof(MiseAJourTicket.TempsPasseMinutes)) is not null)" ErrorText="@Err(nameof(MiseAJourTicket.TempsPasseMinutes))" />
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex flex-wrap align-center gap-1">
                            @foreach (var min in new[] { 15, 30, 60, 120 })
                            {
                                <MudChip T="string" Size="Size.Small" Class="ml-0" OnClick="() => _m.TempsPasseMinutes = (_m.TempsPasseMinutes ?? 0) + min">+@Duree.Minutes(min)</MudChip>
                            }
                        </MudItem>
                    </MudGrid>
                    <div class="d-flex justify-end mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Enregistrer" Disabled="_envoi">Enregistrer</MudButton>
                    </div>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="0" Class="carte pa-4 mb-3">
                    <MudText Typo="Typo.h6" Class="mb-2">Suivi</MudText>
                    <dl class="champ-lecture">
                        <Champ Libelle="Statut" Valeur="@_t.Statut.Libelle()" />
                        <Champ Libelle="Pris en charge par" Valeur="@_t.AssigneA" />
                        @if (!_t.EstOuvert) { <Champ Libelle="Solution apportée" Valeur="@_t.Solution" /> }
                        @if (_t.ResoluLe is { } r) { <Champ Libelle="Résolu le" Valeur="@r.ToLocalTime().ToString("dd/MM/yyyy")" /> }
                    </dl>
                </MudPaper>
            }

            <MudPaper Elevation="0" Class="carte pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Délais</MudText>
                <dl class="champ-lecture">
                    <Champ Libelle="Prise en charge" Valeur="@(_t.PrisEnChargeLe is { } p ? $"{p.ToLocalTime():dd/MM/yyyy HH:mm} (après {Duree.Texte(p - _t.CreeLe)})" : "en attente")" />
                    <Champ Libelle="Résolution" Valeur="@(_t.ResoluLe is { } r2 ? $"{r2.ToLocalTime():dd/MM/yyyy HH:mm} (en {Duree.Texte(r2 - _t.CreeLe)})" : "en cours")" />
                    @if (_t.NbReouvertures > 0) { <Champ Libelle="Réouvertures" Valeur="@_t.NbReouvertures.ToString()" /> }
                    @if (_t.SatisfactionNote is { } n)
                    {
                        <Champ Libelle="Avis du demandeur">
                            <MudRating SelectedValue="n" ReadOnly="true" Size="Size.Small" />
                            @if (_t.SatisfactionCommentaire is not null) { <div style="white-space:pre-line">@_t.SatisfactionCommentaire</div> }
                        </Champ>
                    }
                </dl>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _chargement = true;
    private bool _envoi;
    private Ticket? _t;
    private Utilisateur? _u;
    private MiseAJourTicket _m = new();
    private Dictionary<string, string> _erreurs = [];
    private string? _message;
    private bool _interne;
    private int _note;
    private string? _avis;

    private IEnumerable<TicketMessage> Messages => _t!.Messages.Where(x => _u!.EstAdminTickets || !x.Interne).OrderBy(x => x.Date).ThenBy(x => x.Id);

    private string ClasseMessage(TicketMessage m) => "message-ticket" + (m.Systeme ? " systeme" : m.Interne ? " interne"
        : ServiceTickets.EstDemandeur(new Utilisateur(m.Auteur, m.AuteurEmail, false), _t!) ? "" : " service");

    protected override async Task OnParametersSetAsync()
    {
        _u = await Courant.ObtenirAsync();
        await Charger();
        _chargement = false;
    }

    private async Task Charger()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _t = await db.Tickets.AsNoTracking().Include(x => x.Messages).Include(x => x.Materiel).FirstOrDefaultAsync(x => x.Id == Id);
        if (_t is null) return;
        _m = MiseAJourTicket.Depuis(_t);
        _erreurs = [];
    }

    private string? Err(string champ) => _erreurs.GetValueOrDefault(champ);

    private async Task Executer(Func<Task> action, string succes)
    {
        _envoi = true;
        try
        {
            await action();
            Snackbar.Add(succes, Severity.Success);
            await Charger();
        }
        catch (ErreurFormulaire ex)
        {
            _erreurs = ex.Erreurs;
            Snackbar.Add("Complétez l'analyse avant de résoudre le ticket.", Severity.Error);
        }
        catch (ErreurMetier ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _envoi = false; }
    }

    private Task Envoyer() => Executer(async () =>
    {
        await Service.AjouterMessageAsync(_t!.Id, _message, _interne, _u!);
        _message = null;
    }, _interne ? "Note interne ajoutée." : "Message envoyé.");

    private Task Enregistrer() => Executer(() => Service.MettreAJourAsync(_t!.Id, _m, _u!), "Ticket mis à jour.");

    private Task Confirmer() => Executer(() => Service.ConfirmerResolutionAsync(_t!.Id, _note, _avis, _u!), "Merci, le ticket est clos.");

    private Task Persiste() => Executer(() => Service.SignalerNonResoluAsync(_t!.Id, _avis, _u!), "Le ticket est rouvert, le service informatique va reprendre la main.");
}
