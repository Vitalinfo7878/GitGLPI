@page "/demandes/{IdPublic:guid}"
@attribute [Authorize(Policy = Roles.PolitiqueSalarie)]
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject ServiceDemandes Service
@inject UtilisateurCourant Courant
@inject ISnackbar Snackbar
@inject IDialogService Dialogues

<PageTitle>Demande @(_d?.Numero)</PageTitle>

@if (_chargement)
{
    <Attente />
}
else if (_d is null || !ServiceDemandes.PeutVoir(_u!, _d))
{
    <MudAlert Severity="Severity.Error">Demande introuvable ou accès non autorisé.</MudAlert>
}
else
{
    @if (_u!.VoitToutesLesDemandes)
    {
        <MudBreadcrumbs Items="@([new("Demandes", "/demandes"), new($"n° {_d.Numero}", null, true)])" Class="px-0 pt-0" />
    }
    else
    {
        <MudBreadcrumbs Items="@([new("Mes demandes", "/mes-demandes"), new($"n° {_d.Numero}", null, true)])" Class="px-0 pt-0" />
    }
    <div class="d-flex flex-wrap align-center gap-3 mb-4">
        <MudText Typo="Typo.h4">Demande n° @_d.Numero</MudText>
        <ChipDemande Demande="_d" />
        @if (_d.StatutValidation == StatutValidation.Validee && _d.Priorite == Priorite.Haute)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error">Priorité haute</MudChip>
        }
    </div>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Class="carte pa-4">
                <MudText Typo="Typo.caption">Reçue le @_d.CreeLe.ToLocalTime().ToString("dd/MM/yyyy à HH:mm") (saisie par @_d.SaisiePar)</MudText>
                <dl class="champ-lecture">
                    <Champ Libelle="Nom / Prénom du demandeur" Valeur="@_d.DemandeurNom" />
                    <Champ Libelle="Objet de la demande">
                        @foreach (var o in _d.ListeObjets) { <MudChip T="string" Size="Size.Small" Class="ml-0 mr-1">@o</MudChip> }
                    </Champ>
                    <Champ Libelle="La demande concerne" Valeur="@_d.Concerne" />
                    @if (_d.MaterielRemplace is not null && _u!.VoitToutesLesDemandes)
                    {
                        <Champ Libelle="Ancien matériel (inventaire)">
                            @if (_d.MaterielRemplaceId is { } mid && _u!.VoitInventaire) { <MudLink Href="@($"/materiels/{mid}")">@_d.MaterielRemplace</MudLink> }
                            else { @_d.MaterielRemplace }
                        </Champ>
                    }
                    <Champ Libelle="Adresse mail à créer" Valeur="@_d.AdresseMailACreer" />
                    <Champ Libelle="Raison de la demande" Valeur="@_d.Raison" />
                    <Champ Libelle="Adresse de livraison" Valeur="@_d.AdresseLivraison" />
                    <Champ Libelle="Livraison à l'attention de" Valeur="@_d.DestinataireLivraison" />
                    <Champ Libelle="Mail du demandeur"><a href="mailto:@_d.DemandeurEmail">@_d.DemandeurEmail</a></Champ>
                    <Champ Libelle="Téléphone du demandeur"><a href="tel:@_d.DemandeurTelephone">@_d.DemandeurTelephone</a></Champ>
                    <Champ Libelle="Échéance souhaitée" Valeur="@_d.Echeance?.ToString("dd/MM/yyyy")" />
                </dl>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            @if (_message is not null)
            {
                <MudAlert Severity="@_severite" Class="mb-3">@_message</MudAlert>
            }

            @* --- Décision --- *@
            @if (_d.StatutValidation == StatutValidation.EnAttente)
            {
                @if (_u.EstValideur)
                {
                    <MudPaper Elevation="0" Class="carte pa-4 mb-3">
                        <MudText Typo="Typo.h6" Class="mb-2">Votre décision</MudText>
                        @if (DoitDecider)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Le service informatique vous a répondu : validez ou refusez la demande.</MudAlert>
                        }
                        <MudToggleGroup T="string" @bind-Value="_choix" Color="@(_choix switch { "refuser" => Color.Error, "commenter" => Color.Primary, _ => Color.Success })" Class="mb-3">
                            <MudToggleItem Value="@("valider")" Text="Valider" />
                            <MudToggleItem Value="@("refuser")" Text="Refuser" />
                            @if (!DoitDecider) { <MudToggleItem Value="@("commenter")" Text="Commenter" /> }
                        </MudToggleGroup>
                        @if (_choix == "commenter" && !DoitDecider)
                        {
                            <MudTextField @bind-Value="_commentaire" Immediate="true" MaxLength="4000" Label="Votre commentaire (ex. « Validez-vous ? »)" Lines="3"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudText Typo="Typo.caption" Class="d-block">Envoyé au service informatique, sans valider ni refuser. Non visible du demandeur.</MudText>
                            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send" OnClick="Commenter"
                                       Disabled="@(_envoi || string.IsNullOrWhiteSpace(_commentaire))" FullWidth="true">Envoyer le commentaire</MudButton>
                        }
                        else if (_choix is "valider" or "refuser")
                        {
                            <MudTextField @bind-Value="_commentaire" MaxLength="2000" Label="Commentaire (facultatif)" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudText Typo="Typo.caption" Class="d-block">Commentaire visible uniquement du service informatique et des valideurs. Le demandeur n'est pas prévenu automatiquement : le service informatique reçoit la décision et l'en informe.</MudText>
                            <MudButton Class="mt-3" Variant="Variant.Filled" Color="@(_choix == "refuser" ? Color.Error : Color.Success)" OnClick="Decider" Disabled="_envoi" FullWidth="true">
                                @(_choix == "refuser" ? "Confirmer le refus" : "Confirmer la validation")
                            </MudButton>
                        }
                    </MudPaper>
                }
                else if (_u.EstGestionnaire)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">En attente de validation par le valideur. Pour lui répondre ou lui poser une question, utilisez « Échanges internes ».</MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">Votre demande est en attente de validation.</MudAlert>
                }
            }
            else
            {
                <MudPaper Elevation="0" Class="carte pa-4 mb-3">
                    <MudText Typo="Typo.h6" Class="mb-1">@(_d.StatutValidation == StatutValidation.Validee ? "Validée" : "Refusée")</MudText>
                    <MudText Typo="Typo.body2">par @_d.DecisionPar le @_d.DecisionLe?.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</MudText>
                    @if (!string.IsNullOrEmpty(_d.CommentaireDecision) && _u.VoitToutesLesDemandes)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2" Style="white-space:pre-line"><b>Commentaire</b> <small>(non visible du demandeur)</small> : @_d.CommentaireDecision</MudText>
                    }
                </MudPaper>
            }

            @* --- Traitement par l'informatique --- *@
            @if (_d.StatutValidation == StatutValidation.Validee)
            {
                <MudPaper Elevation="0" Class="carte pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Traitement</MudText>
                    @if (_u.EstGestionnaire)
                    {
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudSelect @bind-Value="_priorite" Label="Priorité" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var p in Enum.GetValues<Priorite>()) { <MudSelectItem Value="p">@p.Libelle()</MudSelectItem> }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudSelect @bind-Value="_statut" Label="Avancement" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var s in Enum.GetValues<StatutRealisation>()) { <MudSelectItem Value="s">@s.Libelle()</MudSelectItem> }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_materielsAttribues" MaxLength="400" Label="@(EstDemandeDeMateriel ? "N° interne du matériel attribué *" : "N° interne du matériel attribué")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="PC0455, E0032"
                                              HelperText="@(EstDemandeDeMateriel ? "Obligatoire pour passer la demande à « Réalisée » ; plusieurs : séparez par une virgule. Rattaché à la fiche matériel." : "Plusieurs : séparez par une virgule. Rattaché à la fiche matériel.")" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_commentaireInfo" MaxLength="4000" Label="Commentaire du service informatique" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              HelperText="Visible par le demandeur ; joint au mail envoyé quand la demande passe à « Réalisée »." />
                            </MudItem>
                            <MudItem xs="12" Class="d-flex flex-wrap gap-2 justify-space-between">
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.SwapHoriz" Href="/mouvements/nouveau">Préparer une attribution</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Enregistrer" Disabled="_envoi">Enregistrer</MudButton>
                            </MudItem>
                            @if (_d.StatutRealisation is not (StatutRealisation.Realisee or StatutRealisation.Annulee))
                            {
                                <MudItem xs="12" Class="pt-3" Style="border-top:1px solid var(--mud-palette-lines-default)">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Outlined.LocalShipping" OnClick="Envoyer" Disabled="_envoi">
                                        Envoyer
                                    </MudButton>
                                    <MudText Typo="Typo.caption" Class="d-block mt-1">
                                        @if (_d.EnvoiNotifieLe is { } e)
                                        {
                                            <span>Demandeur prévenu de l'envoi le @e.ToLocalTime().ToString("dd/MM/yyyy à HH:mm").</span>
                                        }
                                        else
                                        {
                                            <span>Prévient le demandeur par mail que le matériel a été envoyé (réception sous 2 à 3 jours ouvrés) et passe la demande « En cours d'envoi ».</span>
                                        }
                                    </MudText>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <dl class="champ-lecture">
                            <Champ Libelle="Avancement" Valeur="@_d.StatutRealisation.Libelle()" />
                            @if (_d.Materiels.Count > 0) { <Champ Libelle="Matériel attribué" Valeur="@string.Join(", ", _d.Materiels.Select(x => x.Materiel.NumInterne).Order())" /> }
                            @if (_d.EnvoiNotifieLe is { } envoi) { <Champ Libelle="Matériel envoyé le" Valeur="@envoi.ToLocalTime().ToString("dd/MM/yyyy")" /> }
                            <Champ Libelle="Commentaire du service informatique" Valeur="@_d.CommentaireInformatique" />
                            @if (_d.RealiseeLe is { } r) { <Champ Libelle="Clôturée le" Valeur="@r.ToLocalTime().ToString("dd/MM/yyyy")" /> }
                        </dl>
                    }
                </MudPaper>
            }

            @* --- Ticket de rapatriement de l'ancien matériel (remplacement) --- *@
            @if (_rapatriements.Count > 0 && _u.EstAdminTickets)
            {
                <MudPaper Elevation="0" Class="carte pa-4 mt-3">
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudIcon Icon="@Icons.Material.Outlined.AssignmentReturn" />
                        <MudText Typo="Typo.h6">Rapatriement de l'ancien matériel</MudText>
                    </div>
                    @foreach (var rt in _rapatriements)
                    {
                        <div class="d-flex align-center gap-2 py-1">
                            <MudLink Href="@($"/tickets/{rt.Id}")">Ticket n° @rt.Numero</MudLink>
                            <span>@(rt.MaterielReference ?? "matériel à identifier")</span>
                            <MudSpacer />
                            <ChipTicket Statut="rt.Statut" />
                        </div>
                    }
                    <MudText Typo="Typo.caption">Retour de l'ancien matériel et son devenir : les mouvements y sont notés automatiquement.</MudText>
                </MudPaper>
            }

            @if (_rapatriements.Count == 0 && _u.EstGestionnaire && EstDemandeDeMateriel && _d.StatutValidation != StatutValidation.Refusee)
            {
                <MudPaper Elevation="0" Class="carte pa-4 mt-3">
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudIcon Icon="@Icons.Material.Outlined.AssignmentReturn" />
                        <MudText Typo="Typo.h6">Rapatriement de l'ancien matériel</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        @(_d.EstRemplacement ? "Aucun ticket de rapatriement : demande reçue avant leur création automatique." : "Cette demande n'est pas un remplacement : créez le ticket si un ancien matériel doit tout de même être récupéré.")
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddTask" OnClick="CreerRapatriement" Disabled="_envoi">
                        Créer le ticket de rapatriement
                    </MudButton>
                </MudPaper>
            }

            @* --- Échanges internes valideur / service informatique --- *@
            @if (_u.VoitToutesLesDemandes)
            {
                <MudPaper Elevation="0" Class="carte pa-4 mt-3" id="echanges">
                    <MudText Typo="Typo.h6">Échanges internes</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-2">Entre le valideur et le service informatique : non visibles du demandeur. Chaque message est envoyé par mail aux autres.</MudText>
                    @foreach (var m in _messages)
                    {
                        <div class="py-2" style="border-top:1px solid var(--mud-palette-lines-default)">
                            <MudText Typo="Typo.caption"><b>@m.Auteur</b> · @m.Le.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</MudText>
                            <MudText Typo="Typo.body2" Style="white-space:pre-line">@m.Texte</MudText>
                        </div>
                    }
                    @if (_u.EstValideur && !_u.EstGestionnaire && _d.StatutValidation == StatutValidation.EnAttente)
                    {
                        @if (_messages.Count == 0) { <MudText Typo="Typo.body2" Class="mt-2">Aucun échange. Pour écrire au service informatique, choisissez « Commenter » ci-dessus.</MudText> }
                    }
                    else
                    {
                        <MudTextField @bind-Value="_nouveauMessage" Immediate="true" MaxLength="4000" Label="@(_messages.Count == 0 ? "Message (ex. « Validez-vous ? »)" : "Répondre")" Lines="2"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                        <div class="d-flex justify-end mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send" OnClick="EnvoyerMessage"
                                       Disabled="@(_envoi || string.IsNullOrWhiteSpace(_nouveauMessage))">Envoyer le message</MudButton>
                        </div>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid IdPublic { get; set; }
    [SupplyParameterFromQuery(Name = "choix")] public string? ChoixQuery { get; set; }

    private bool _chargement = true;
    private bool _envoi;
    private Demande? _d;
    private Utilisateur? _u;
    private string? _choix;
    private string? _commentaire;
    private bool DoitDecider => _d is not null && ServiceDemandes.ValideurDoitDecider(_u!, _d, _messages);
    private Priorite _priorite;
    private StatutRealisation _statut;
    private string? _commentaireInfo;
    private string? _materielsAttribues;
    private bool EstDemandeDeMateriel => _d is not null && ServiceTickets.TypesDemandes(_d).Count > 0;
    private string? _message;
    private Severity _severite;
    private List<MessageDemande> _messages = [];
    private List<Ticket> _rapatriements = [];
    private string? _nouveauMessage;

    protected override async Task OnParametersSetAsync()
    {
        _u = await Courant.ObtenirAsync();
        _choix = ChoixQuery is "valider" or "refuser" ? ChoixQuery : null;
        await Charger();
        _chargement = false;
    }

    private async Task Charger()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _d = await db.Demandes.AsNoTracking().Include(x => x.Materiels).ThenInclude(x => x.Materiel).FirstOrDefaultAsync(x => x.IdPublic == IdPublic);
        if (_d is null) return;
        _messages = await Service.ListerMessagesAsync(_d.Id, _u!);
        _rapatriements = _u!.EstAdminTickets ? await db.Tickets.AsNoTracking().Where(t => t.DemandeId == _d.Id).OrderBy(t => t.Numero).ToListAsync() : [];
        _priorite = _d.Priorite;
        _statut = _d.StatutRealisation;
        _commentaireInfo = _d.CommentaireInformatique;
        _materielsAttribues = string.Join(", ", _d.Materiels.Select(x => x.Materiel.NumInterne).Order());
    }

    private void Afficher(string message, Severity s)
    {
        _message = message;
        _severite = s;
    }

    private async Task Decider()
    {
        _envoi = true;
        try
        {
            var r = await Service.DeciderAsync(IdPublic, _choix == "valider", _commentaire, _u!);
            Afficher(r.AvertissementCourriel is null
                ? $"Demande {(_choix == "valider" ? "validée" : "refusée")}. Le service informatique a été prévenu."
                : $"Décision enregistrée, mais un courriel n'a pas pu partir : {r.AvertissementCourriel}",
                r.AvertissementCourriel is null ? Severity.Success : Severity.Warning);
            await Charger();
        }
        catch (ErreurMetier ex)
        {
            Afficher(ex.Message, Severity.Error);
            await Charger();
        }
        finally { _envoi = false; }
    }

    private async Task Commenter()
    {
        if (await PublierAsync(_commentaire))
        {
            _commentaire = null;
            _choix = null;
        }
    }

    private async Task EnvoyerMessage()
    {
        if (await PublierAsync(_nouveauMessage)) _nouveauMessage = null;
    }

    private async Task<bool> PublierAsync(string? texte)
    {
        _envoi = true;
        try
        {
            var r = await Service.AjouterMessageAsync(IdPublic, texte, _u!);
            Snackbar.Add(r.AvertissementCourriel is null ? "Message envoyé." : $"Message enregistré, mais un courriel n'a pas pu partir : {r.AvertissementCourriel}",
                r.AvertissementCourriel is null ? Severity.Success : Severity.Warning);
            await Charger();
            return true;
        }
        catch (ErreurMetier ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await Charger();
            return false;
        }
        finally { _envoi = false; }
    }

    private async Task Envoyer()
    {
        var ok = await Dialogues.ShowMessageBoxAsync("Matériel envoyé ?",
            $"{_d!.DemandeurNom} ({_d.DemandeurEmail}) va recevoir un mail indiquant que le matériel a été envoyé et qu'il devrait le recevoir sous 2 à 3 jours ouvrés."
            + (_d.EnvoiNotifieLe is null ? "" : " Attention : il a déjà été prévenu une fois."),
            yesText: "Prévenir le demandeur", cancelText: "Annuler");
        if (ok != true) return;
        _envoi = true;
        try
        {
            var r = await Service.NotifierEnvoiAsync(_d.Id, _u!);
            Snackbar.Add(r.AvertissementCourriel is null ? "Demandeur prévenu de l'envoi." : $"Demande mise à jour, mais le mail n'a pas pu partir : {r.AvertissementCourriel}",
                r.AvertissementCourriel is null ? Severity.Success : Severity.Warning);
            await Charger();
        }
        catch (ErreurMetier ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _envoi = false; }
    }

    private async Task CreerRapatriement()
    {
        _envoi = true;
        try
        {
            var n = await Service.CreerTicketsRapatriementAsync(_d!.Id, _u!);
            Snackbar.Add(n == 1 ? "Ticket de rapatriement créé." : $"{n} tickets de rapatriement créés.", Severity.Success);
            await Charger();
        }
        catch (ErreurMetier ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _envoi = false; }
    }

    private async Task Enregistrer()
    {
        _envoi = true;
        try
        {
            var r = await Service.MettreAJourTraitementAsync(_d!.Id, _priorite, _statut, _commentaireInfo, _u!,
                materiels: (_materielsAttribues ?? "").Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
            Snackbar.Add(r.AvertissementCourriel ?? "Demande mise à jour.", r.AvertissementCourriel is null ? Severity.Success : Severity.Warning);
            await Charger();
        }
        catch (ErreurMetier ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _envoi = false; }
    }
}
