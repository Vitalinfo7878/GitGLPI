@page "/"
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject UtilisateurCourant Courant

<PageTitle>Accueil – Parc informatique</PageTitle>

@if (_u is null)
{
    <Attente />
}
else if (!_u.EstGestionnaire)
{
    <MudText Typo="Typo.h4" Class="mb-1">Bonjour @_u.Nom</MudText>
    <MudText Class="mb-4" Style="color:var(--mud-palette-text-secondary)">Retrouvez ici le matériel informatique qui vous est attribué.</MudText>
    <div class="d-flex flex-wrap gap-2 mb-6">
        <MudButton Href="/demandes/nouvelle" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddShoppingCart">Faire une demande de matériel</MudButton>
        <MudButton Href="/mes-demandes" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ListAlt">Suivre mes demandes</MudButton>
        <MudButton Href="/tickets/nouveau" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ReportProblem">Créer un ticket</MudButton>
    </div>
    @if (_u.EstAdminTickets && _ticketsOuverts > 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-6">
            <b>@_ticketsOuverts</b> ticket(s) ouvert(s), dont <b>@_ticketsNouveaux</b> à prendre en charge. <MudLink Href="/tickets">Voir les tickets</MudLink>
        </MudAlert>
    }
    @if (_u.EstValideur && _demandesAValider > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-6">
            <b>@_demandesAValider</b> demande(s) attendent votre validation. <MudLink Href="/demandes">Voir les demandes</MudLink>
        </MudAlert>
    }
    <MonMateriel EstPage="false" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-1">Tableau de bord</MudText>
    <MudText Class="mb-6" Style="color:var(--mud-palette-text-secondary)">Vue d'ensemble du parc informatique.</MudText>

    @if (_stats is null)
    {
        <Attente />
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var t in Enum.GetValues<TypeMateriel>())
            {
                <MudItem xs="6" md="3">
                    <MudPaper Elevation="0" Class="carte pa-4">
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">@t.Libelle() en service</MudText>
                        <div class="chiffre">@_stats.EnService.GetValueOrDefault(t)</div>
                        <MudText Typo="Typo.caption">@_stats.EnStock.GetValueOrDefault(t) en stock</MudText>
                    </MudPaper>
                </MudItem>
            }
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="carte pa-4" Style="height:100%">
                    <MudText Typo="Typo.h6" Class="mb-3">À traiter</MudText>
                    <MudList T="string" Dense="true" ReadOnly="true">
                        <MudListItem Icon="@Icons.Material.Outlined.FactCheck" IconColor="Color.Warning" Href="/demandes">
                            <b>@_demandesAValider</b> demande(s) à valider, <b>@_demandesATraiter</b> à traiter
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Outlined.ConfirmationNumber" IconColor="Color.Warning" Href="/tickets">
                            <b>@_ticketsOuverts</b> ticket(s) ouvert(s), dont <b>@_ticketsNouveaux</b> à prendre en charge
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Outlined.Autorenew" IconColor="Color.Primary" Href="/inventaire?filtre=achanger">
                            <b>@_stats.AChanger</b> PC à changer
                        </MudListItem>
                        @* Statut repris de l'ancien inventaire, qui n'est plus produit par les mouvements *@
                        @if (_stats.ParStatut.GetValueOrDefault(StatutMateriel.RebutEnAttente) is > 0 and var attenteRebut)
                        {
                            <MudListItem Icon="@Icons.Material.Outlined.DeleteOutline" IconColor="Color.Dark" Href="/inventaire?statut=RebutEnAttente">
                                <b>@attenteRebut</b> en attente de rebut
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="carte pa-4" Style="height:100%">
                    <MudText Typo="Typo.h6" Class="mb-3">Répartition</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td>Parc sites</td><td class="text-right"><b>@_stats.ParcSites</b></td></tr>
                            <tr><td>Parc personnes</td><td class="text-right"><b>@_stats.ParcPersonnes</b></td></tr>
                            @foreach (var s in _stats.ParStatut.OrderBy(k => k.Key))
                            {
                                <tr><td><ChipStatut Statut="s.Key" /></td><td class="text-right">@s.Value</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
}

@code {
    private Utilisateur? _u;
    private Stats? _stats;
    private int _demandesAValider, _demandesATraiter;
    private int _ticketsOuverts, _ticketsNouveaux;

    private sealed record Stats(
        Dictionary<TypeMateriel, int> EnService, Dictionary<TypeMateriel, int> EnStock, Dictionary<StatutMateriel, int> ParStatut,
        int AChanger, int ParcSites, int ParcPersonnes);

    protected override async Task OnInitializedAsync()
    {
        _u = await Courant.ObtenirAsync();
        if (_u.EstGestionnaire) await Charger();
        else if (_u.EstValideur || _u.EstAdminTickets)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_u.EstValideur) _demandesAValider = await db.Demandes.CountAsync(d => d.StatutValidation == StatutValidation.EnAttente);
            if (_u.EstAdminTickets) await CompterTickets(db);
        }
    }

    private async Task Charger()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var lignes = await db.Materiels.GroupBy(m => new { m.Type, m.Statut }).Select(g => new { g.Key.Type, g.Key.Statut, N = g.Count() }).ToListAsync();
        _stats = new Stats(
            lignes.Where(l => l.Statut == StatutMateriel.Attribue).ToDictionary(l => l.Type, l => l.N),
            lignes.Where(l => l.Statut == StatutMateriel.EnStock).ToDictionary(l => l.Type, l => l.N),
            lignes.GroupBy(l => l.Statut).ToDictionary(g => g.Key, g => g.Sum(l => l.N)),
            await db.Materiels.CountAsync(m => m.AChanger && m.Statut == StatutMateriel.Attribue),
            await db.Materiels.CountAsync(m => m.SiteId != null),
            await db.Materiels.CountAsync(m => m.PersonneId != null));
        _demandesAValider = await db.Demandes.CountAsync(d => d.StatutValidation == StatutValidation.EnAttente);
        _demandesATraiter = await db.Demandes.CountAsync(d => d.StatutValidation == StatutValidation.Validee
            && d.StatutRealisation != StatutRealisation.Realisee && d.StatutRealisation != StatutRealisation.Annulee);
        await CompterTickets(db);
    }

    private async Task CompterTickets(ParcDbContext db)
    {
        _ticketsOuverts = await db.Tickets.CountAsync(t => t.Statut != StatutTicket.Resolu && t.Statut != StatutTicket.Clos);
        _ticketsNouveaux = await db.Tickets.CountAsync(t => t.Statut == StatutTicket.Nouveau);
    }

}
