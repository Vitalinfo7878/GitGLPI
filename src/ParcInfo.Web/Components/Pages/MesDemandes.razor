@page "/mes-demandes"
@attribute [Authorize(Policy = Roles.PolitiqueSalarie)]
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject UtilisateurCourant Courant

<PageTitle>Mes demandes</PageTitle>
<div class="d-flex flex-wrap align-center gap-2 mb-4">
    <MudText Typo="Typo.h4">Mes demandes</MudText>
    <MudSpacer />
    <MudButton Href="/demandes/nouvelle" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Faire une demande</MudButton>
</div>

@if (_demandes is null)
{
    <Attente />
}
else if (_demandes.Count == 0)
{
    <MudPaper Elevation="0" Class="carte pa-6">
        <MudText>Vous n'avez fait aucune demande pour l'instant.</MudText>
    </MudPaper>
}
else
{
    <MudStack Spacing="2">
        @foreach (var d in _demandes)
        {
            <MudPaper Elevation="0" Class="carte pa-4">
                <a href="@($"/demandes/{d.IdPublic}")" style="color:inherit;text-decoration:none;display:block">
                    <div class="d-flex flex-wrap align-center gap-2">
                        <MudText Typo="Typo.h6">N° @d.Numero</MudText>
                        <ChipDemande Demande="d" />
                        <MudSpacer />
                        <MudText Typo="Typo.caption">@d.CreeLe.ToLocalTime().ToString("dd/MM/yyyy")</MudText>
                    </div>
                    <MudText Typo="Typo.body2">@d.Objets · @d.Concerne</MudText>
                    @if (d.StatutValidation == StatutValidation.Refusee && d.CommentaireDecision is not null)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-error)">Motif : @d.CommentaireDecision</MudText>
                    }
                </a>
            </MudPaper>
        }
    </MudStack>
}

@code {
    private List<Demande>? _demandes;

    protected override async Task OnInitializedAsync()
    {
        var u = await Courant.ObtenirAsync();
        var adresses = u.ToutesAdresses;
        await using var db = await DbFactory.CreateDbContextAsync();
        _demandes = await db.Demandes.AsNoTracking()
            .Where(d => adresses.Contains(d.SaisiePar) || adresses.Contains(d.DemandeurEmail))
            .OrderByDescending(d => d.Numero).ToListAsync();
    }
}
