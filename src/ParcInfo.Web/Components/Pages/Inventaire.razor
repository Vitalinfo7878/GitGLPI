@page "/inventaire"
@attribute [Authorize(Policy = Roles.PolitiqueInventaire)]
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject NavigationManager Nav
@inject ServiceMouvements Mouvements
@inject UtilisateurCourant Courant
@inject ISnackbar Snackbar

<PageTitle>Inventaire</PageTitle>

<div class="d-flex flex-wrap align-center gap-2 mb-4">
    <MudText Typo="Typo.h4">Inventaire</MudText>
    <MudSpacer />
    <MudButton Href="/journal-inventaire" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.History">Journal d'inventaire</MudButton>
    <MudButton Href="/export/inventaire.xlsx" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.FileDownload">Export Excel</MudButton>
    @if (_gestionnaire)
    {
    <MudButton Href="/achat" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.LocalShipping">Réception d'achat</MudButton>
    <MudButton Href="/materiels/nouveau" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AddBox">Nouveau matériel</MudButton>
    <MudMenu Label="Catégorie PC" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Category" Disabled="_selection.Count == 0"
             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
        @foreach (var c in Enum.GetValues<CategoriePc>())
        {
            <MudMenuItem OnClick="() => DefinirCategorie(c)">@c.Libelle()</MudMenuItem>
        }
        <MudMenuItem OnClick="() => DefinirCategorie(null)">Non renseignée</MudMenuItem>
    </MudMenu>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.SwapHoriz"
               Disabled="_selection.Count == 0" OnClick="NouveauMouvement">
        Mouvement@(_selection.Count > 0 ? $" ({_selection.Count})" : "")
    </MudButton>
    }
</div>

<MudPaper Elevation="0" Class="carte pa-3 mb-3">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" Value="_recherche" ValueChanged="Rechercher" Immediate="true" DebounceInterval="250"
                          Placeholder="N° interne, modèle, n° série, site, personne, mail, compte Microsoft…" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="string" Value="_categorie" ValueChanged="v => Filtrer(() => _categorie = v)" Label="Catégorie PC" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("")">Tous</MudSelectItem>
                @foreach (var c in Enum.GetValues<CategoriePc>()) { <MudSelectItem Value="@c.ToString()">@c.Libelle()</MudSelectItem> }
                <MudSelectItem Value="@("aucune")">PC non renseignés</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="TypeMateriel?" Value="_type" ValueChanged="v => Filtrer(() => _type = v)" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var t in Enum.GetValues<TypeMateriel>())
                {
                    <MudSelectItem T="TypeMateriel?" Value="t">@t.Libelle()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="StatutMateriel?" Value="_statut" ValueChanged="v => Filtrer(() => _statut = v)" Label="Statut" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var s in Enum.GetValues<StatutMateriel>().Where(s => s != StatutMateriel.EnReparation))
                {
                    <MudSelectItem T="StatutMateriel?" Value="s">@s.Libelle()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="string" Value="_region" ValueChanged="v => Filtrer(() => _region = v)" Label="Région / service" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var r in _regions)
                {
                    <MudSelectItem Value="r">@r</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @* Recherche ciblée : chaque case ne cherche que dans son champ (« 227 » en site = site 227, pas PO0227) *@
        @foreach (var (libelle, valeur, aide) in new (string, string?, string)[]
        {
            ("Site", _fSite, "227 ou nom"), ("Personne", _fPersonne, "Nom"), ("N° interne", _fInterne, ""),
            ("N° de série", _fSerie, ""), ("N° de facture", _fFacture, ""), ("N° d'immobilisation", _fImmo, ""),
        })
        {
            <MudItem xs="6" sm="4" md="2">
                <MudTextField T="string" Value="valeur" ValueChanged="v => Filtrer(() => DefinirCible(libelle, v))" Immediate="true" DebounceInterval="250"
                              Label="@libelle" Placeholder="@aide" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
            </MudItem>
        }
        <MudItem xs="12" Class="d-flex flex-wrap align-center gap-4 pt-0">
            <MudCheckBox T="bool" Value="_aChanger" ValueChanged="v => Filtrer(() => _aChanger = v)" Label="PC à changer" Dense="true" />
            <MudCheckBox T="bool" Value="_masquerRebut" ValueChanged="v => Filtrer(() => _masquerRebut = v)" Label="Masquer le matériel rebuté" Dense="true" />
            <MudSpacer />
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">@_filtres.Count matériel(s)</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_tous is null)
{
    <Attente />
}
else
{
    <MudDataGrid T="Ligne" Items="_filtres" MultiSelection="_gestionnaire" @bind-SelectedItems="_selection" Hover="true" Dense="true"
                 Elevation="0" Class="carte" RowClick="Ouvrir" RowClass="lien-ligne"
                 RowsPerPage="50" SortMode="SortMode.Single" HorizontalScrollbar="true">
        <Columns>
            @if (_gestionnaire) { <SelectColumn T="Ligne" /> }
            <PropertyColumn Property="x => x.NumInterne" Title="N° interne" CellStyle="font-weight:600;white-space:nowrap" />
            <PropertyColumn Property="x => x.TypeLibelle" Title="Type" />
            <TemplateColumn T="Ligne" Title="Catégorie PC" SortBy="x => x.CategoriePc">
                <CellTemplate>@if (context.Item.CategoriePc is { } cat) { <ChipCategoriePc Categorie="cat" /> }</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Modele" Title="Modèle" />
            <PropertyColumn Property="x => x.NumSerie" Title="N° série" />
            <TemplateColumn T="Ligne" Title="Site / personne" SortBy="x => x.Detenteur">
                <CellTemplate>
                    @if (context.Item.Parc == TypeDetenteur.Site)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Restaurant" Size="Size.Small" Class="mr-1" Style="vertical-align:middle" />
                    }
                    else if (context.Item.Parc == TypeDetenteur.Personne)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="mr-1" Style="vertical-align:middle" />
                    }
                    @context.Item.Detenteur
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Email" Title="Mail" />
            <PropertyColumn Property="x => x.Region" Title="Région / service" />
            <TemplateColumn T="Ligne" Title="Statut" SortBy="x => x.Statut">
                <CellTemplate><ChipStatut Statut="context.Item.Statut" /></CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.ProfilMicrosoft" Title="Profil Microsoft" />
            <PropertyColumn Property="x => x.VersionWindows" Title="Windows" />
            <PropertyColumn Property="x => x.Note" Title="Note /5" />
            <PropertyColumn Property="x => x.Annee" Title="Année" />
            <PropertyColumn Property="x => x.NumFacture" Title="N° facture" />
            <PropertyColumn Property="x => x.NumImmo" Title="N° immo" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Ligne" PageSizeOptions="[25, 50, 100, 500]" RowsPerPageString="Lignes par page :"
                              InfoFormat="{first_item}-{last_item} sur {all_items}" />
        </PagerContent>
        <NoRecordsContent><MudText>Aucun matériel ne correspond aux filtres.</MudText></NoRecordsContent>
    </MudDataGrid>
}

@code {
    [SupplyParameterFromQuery(Name = "statut")] public string? StatutQuery { get; set; }
    [SupplyParameterFromQuery(Name = "filtre")] public string? FiltreQuery { get; set; }

    private sealed record Ligne(
        int Id, string NumInterne, TypeMateriel Type, string TypeLibelle, CategoriePc? CategoriePc, string? Modele, string? NumSerie, TypeDetenteur Parc,
        string Detenteur, string? Email, string? Region, StatutMateriel Statut, string? ProfilMicrosoft, string? VersionWindows, int? Note,
        int? Annee, bool AChanger, string Recherche, string? NumFacture, string? NumImmo, string? SiteCode, string? SiteNom, string? PersonneNom)
    {
        // Une ligne = un matériel : la sélection de la grille survit à la mise à jour d'une ligne
        public bool Equals(Ligne? autre) => autre?.Id == Id;
        public override int GetHashCode() => Id;
    }

    private List<Ligne>? _tous;
    private List<Ligne> _filtres = [];
    private HashSet<Ligne> _selection = [];
    private List<string> _regions = [];
    /// <summary>Service informatique ; sinon consultation seule (pas d'export, de sélection ni d'action).</summary>
    private bool _gestionnaire;

    private string? _recherche;
    private string _categorie = "";
    private TypeMateriel? _type;
    private StatutMateriel? _statut;
    private string? _region;
    private bool _aChanger;
    private bool _masquerRebut = true;
    private string? _fSite, _fPersonne, _fInterne, _fSerie, _fFacture, _fImmo;

    private void DefinirCible(string champ, string? v)
    {
        switch (champ)
        {
            case "Site": _fSite = v; break;
            case "Personne": _fPersonne = v; break;
            case "N° interne": _fInterne = v; break;
            case "N° de série": _fSerie = v; break;
            case "N° de facture": _fFacture = v; break;
            default: _fImmo = v; break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _gestionnaire = (await Courant.ObtenirAsync()).EstGestionnaire;
        if (Enum.TryParse<StatutMateriel>(StatutQuery, out var s)) { _statut = s; _masquerRebut = false; }
        if (FiltreQuery == "achanger") _aChanger = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var materiels = await db.Materiels.AsNoTracking()
            .Select(m => new
            {
                m.Id, m.NumInterne, m.Type, m.CategoriePc, m.Modele, m.NumSerie, m.SiteId, m.PersonneId,
                SiteCode = m.Site!.Code, SiteNom = m.Site.Nom, SiteRelie = m.Site.EntraObjectId != null, SiteRegion = m.Site.Region!.Nom, Personne = m.Personne!.NomComplet,
                Email = m.Personne.Email ?? m.Site.Email,
                Region = m.Region!.Nom, m.Statut, m.ProfilMicrosoft, m.VersionWindows, m.Note, m.AnneeAcquisition, m.AChanger, m.NumFacture, m.NumImmo,
            })
            .ToListAsync();

        _tous = materiels.Select(m =>
        {
            var parc = m.SiteId != null ? TypeDetenteur.Site : m.PersonneId != null ? TypeDetenteur.Personne : TypeDetenteur.Aucun;
            var detenteur = parc switch
            {
                TypeDetenteur.Site => Site.LibelleDe(m.SiteCode, m.SiteNom, m.SiteRelie),
                TypeDetenteur.Personne => m.Personne ?? "",
                _ => "",
            };
            var region = m.Region ?? m.SiteRegion;
            var recherche = Normaliser($"{m.NumInterne} {m.Modele} {m.NumSerie} {detenteur} {m.Email} {m.ProfilMicrosoft} {region} {m.NumFacture} {m.NumImmo}");
            return new Ligne(m.Id, m.NumInterne, m.Type, m.Type.Libelle(), m.CategoriePc, m.Modele, m.NumSerie, parc, detenteur, m.Email, region, m.Statut,
                m.ProfilMicrosoft, m.VersionWindows, m.Note, m.AnneeAcquisition, m.AChanger, recherche, m.NumFacture, m.NumImmo,
                parc == TypeDetenteur.Site ? m.SiteCode : null, parc == TypeDetenteur.Site ? Normaliser(detenteur) : null,
                parc == TypeDetenteur.Personne ? Normaliser(detenteur) : null);
        }).OrderBy(l => l.NumInterne).ToList();
        _regions = _tous.Select(l => l.Region).OfType<string>().Distinct().Order().ToList();
        Appliquer();
    }

    private static string Normaliser(string s) => ParcInfo.Web.Import.Normalisation.SansAccents(s).ToLowerInvariant();

    private void Rechercher(string? texte) => Filtrer(() => _recherche = texte);

    private void Filtrer(Action changement)
    {
        changement();
        Appliquer();
    }

    private void Appliquer()
    {
        if (_tous is null) return;
        IEnumerable<Ligne> q = _tous;
        if (!string.IsNullOrWhiteSpace(_recherche))
        {
            var mots = Normaliser(_recherche).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            q = q.Where(l => mots.All(l.Recherche.Contains));
        }
        // Recherche ciblée
        if (!string.IsNullOrWhiteSpace(_fSite))
        {
            var site = _fSite.Trim();
            // Un numéro (« 227 », « 087 », « 440-1 », « S012 ») : ce site exactement ; sinon le nom du site
            if (System.Text.RegularExpressions.Regex.IsMatch(site, @"^[a-zA-Z]?\d+(-\d+)?$"))
                q = q.Where(l => l.SiteCode is { } c && (c.Equals(site, StringComparison.OrdinalIgnoreCase)
                    || c.TrimStart('0').Equals(site.TrimStart('0'), StringComparison.OrdinalIgnoreCase)));
            else
            {
                var n = Normaliser(site);
                q = q.Where(l => l.SiteNom?.Contains(n) == true);
            }
        }
        if (!string.IsNullOrWhiteSpace(_fPersonne))
        {
            var mots = Normaliser(_fPersonne).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            q = q.Where(l => l.PersonneNom is { } p && mots.All(p.Contains));
        }
        static bool Contient(string? valeur, string? cherche) => string.IsNullOrWhiteSpace(cherche)
            || (valeur is not null && Normaliser(valeur).Replace(" ", "").Contains(Normaliser(cherche).Replace(" ", "")));
        q = q.Where(l => Contient(l.NumInterne, _fInterne) && Contient(l.NumSerie, _fSerie) && Contient(l.NumFacture, _fFacture) && Contient(l.NumImmo, _fImmo));

        if (Enum.TryParse<CategoriePc>(_categorie, out var cat)) q = q.Where(l => l.CategoriePc == cat);
        else if (_categorie == "aucune") q = q.Where(l => l.CategoriePc is null && l.Type is TypeMateriel.PcFixe or TypeMateriel.PcPortable);
        if (_type is { } t) q = q.Where(l => l.Type == t);
        if (_statut is { } s) q = q.Where(l => l.Statut == s);
        else if (_masquerRebut) q = q.Where(l => l.Statut != StatutMateriel.Rebute);
        if (_region is not null) q = q.Where(l => l.Region == _region);
        if (_aChanger) q = q.Where(l => l.AChanger);
        _filtres = q.ToList();
    }

    private void Ouvrir(DataGridRowClickEventArgs<Ligne> e) => Nav.NavigateTo($"/materiels/{e.Item.Id}");

    private async Task DefinirCategorie(CategoriePc? categorie)
    {
        try
        {
            var ids = _selection.Select(l => l.Id).ToHashSet();
            var n = await Mouvements.DefinirCategoriePcAsync(ids, categorie, await Courant.ObtenirAsync());
            Snackbar.Add(n == 0 ? "Aucun PC dans la sélection." : $"{n} PC : {categorie?.Libelle() ?? "catégorie effacée"}.", n == 0 ? Severity.Warning : Severity.Success);
            // Mise à jour des lignes sur place : la sélection reste en place pour enchaîner une autre action
            _tous = _tous!.Select(l => ids.Contains(l.Id) && l.Type is TypeMateriel.PcFixe or TypeMateriel.PcPortable ? l with { CategoriePc = categorie } : l).ToList();
            Appliquer();
        }
        catch (ErreurMetier ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void NouveauMouvement() =>
        Nav.NavigateTo($"/mouvements/nouveau?ids={string.Join(',', _selection.Select(l => l.Id))}");
}
