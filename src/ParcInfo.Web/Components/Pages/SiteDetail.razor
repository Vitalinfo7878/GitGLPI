@page "/sites/{Id:int}"
@attribute [Authorize(Policy = Roles.PolitiqueGestion)]
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject UtilisateurCourant Courant
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_site?.Libelle ?? "Site")</PageTitle>

@if (_site is null)
{
    <Attente />
}
else
{
    <MudBreadcrumbs Items="@([new("Sites", "/sites"), new(Id == 0 ? "Nouveau site" : _site.Libelle, null, true)])" Class="px-0 pt-0" />
    <MudText Typo="Typo.h4" Class="mb-4">@(Id == 0 ? "Nouveau site" : _site.Libelle)</MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="5">
            <MudPaper Elevation="0" Class="carte pa-4">
                <EditForm Model="_site" OnValidSubmit="Enregistrer">
                    <MudGrid Spacing="2">
                        <MudItem xs="5"><MudTextField MaxLength="400" @bind-Value="_site.Code" Label="Code" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="7"><MudTextField MaxLength="400" @bind-Value="_site.Nom" Label="Nom" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12">
                            <MudSelect T="int?" @bind-Value="_site.RegionId" Label="Région" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                @foreach (var r in _regions) { <MudSelectItem T="int?" Value="r.Id">@r.Nom</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="7"><MudTextField MaxLength="400" @bind-Value="_site.Responsable" Label="Responsable" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="5"><MudTextField MaxLength="400" @bind-Value="_site.Telephone" Label="Téléphone" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12"><MudTextField MaxLength="400" @bind-Value="_site.Email" Label="Adresse mail du site" HelperText="Reçoit les demandes de confirmation de réception" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12"><MudTextField MaxLength="400" @bind-Value="_site.Adresse" Label="Adresse postale" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12"><MudCheckBox @bind-Value="_site.Actif" Label="Site actif" /></MudItem>
                        <MudItem xs="12" Class="d-flex justify-end">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Enregistrer</MudButton>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </MudPaper>
        </MudItem>
        @if (Id != 0)
        {
            <MudItem xs="12" lg="7">
                <ListeMateriel Titre="Matériel du site" Materiels="_materiels" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public int Id { get; set; }

    private Site? _site;
    private List<Region> _regions = [];
    private List<Materiel> _materiels = [];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _regions = await db.Regions.OrderBy(r => r.Nom).ToListAsync();
        _site = Id == 0 ? new Site() : await db.Sites.AsNoTracking().FirstOrDefaultAsync(s => s.Id == Id);
        if (_site is null) { Nav.NavigateTo("/sites"); return; }
        _materiels = await db.Materiels.AsNoTracking().Where(m => m.SiteId == Id).OrderBy(m => m.Type).ThenBy(m => m.NumInterne).ToListAsync();
    }

    private async Task Enregistrer()
    {
        _site!.Code = _site.Code.Trim().ToUpperInvariant();
        _site.Email = string.IsNullOrWhiteSpace(_site.Email) ? null : _site.Email.Trim().ToLowerInvariant();
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Sites.AnyAsync(s => s.Code == _site.Code && s.Id != _site.Id))
        {
            Snackbar.Add($"Le code {_site.Code} existe déjà.", Severity.Error);
            return;
        }
        db.Sites.Update(_site);
        var u = await Courant.ObtenirAsync();
        db.Journal.Add(new Journal { Date = DateTime.UtcNow, Utilisateur = u.Signature, Action = Id == 0 ? "Site créé" : "Site modifié", Details = _site.Code });
        await db.SaveChangesAsync();
        Snackbar.Add("Site enregistré.", Severity.Success);
        if (Id == 0) Nav.NavigateTo($"/sites/{_site.Id}");
    }
}
