@page "/achat"
@attribute [Authorize(Policy = Roles.PolitiqueGestion)]
@inject ServiceMouvements Service
@inject UtilisateurCourant Courant

<PageTitle>Réception d'achat</PageTitle>
<MudText Typo="Typo.h4" Class="mb-1">Réception d'achat</MudText>
<MudText Class="mb-4" Style="color:var(--mud-palette-text-secondary)">
    Enregistre le matériel reçu d'un fournisseur : il entre en stock et une fiche d'achat (FIS) est générée.
</MudText>

@if (_resultat is not null)
{
    <MudPaper Elevation="0" Class="carte pa-5">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="vertical-align:middle" /> Matériel entré en stock
        </MudText>
        <MudText Class="mb-3">Mouvements n° @string.Join(", ", _resultat.Numeros)</MudText>
        @if (_resultat.Fiche is { } f)
        {
            <MudButton Href="@($"/fiches/{f.IdPublic}/pdf")" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PictureAsPdf">Fiche @f.Code</MudButton>
        }
        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NouvelleReception">Nouvelle réception</MudButton>
            <MudButton Href="/inventaire?statut=EnStock" Variant="Variant.Text">Voir le stock</MudButton>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Elevation="0" Class="carte pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudDatePicker Date="@(_d.Date.ToDateTime(TimeOnly.MinValue))" DateChanged="@((DateTime? d) => _d.Date = DateOnly.FromDateTime(d ?? DateTime.Today))"
                               Label="Date de réception" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="3"><MudTextField MaxLength="400" @bind-Value="_d.Fournisseur" Label="Fournisseur *" Placeholder="AMAZON, CELERIS…" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField MaxLength="400" @bind-Value="_d.DocumentReference" Label="Devis / bon de commande" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField MaxLength="400" @bind-Value="_d.Commentaire" Label="Commentaire" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="CategoriePc?" @bind-Value="_d.CategoriePc" Label="Catégorie des PC reçus" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var c in Enum.GetValues<CategoriePc>()) { <MudSelectItem T="CategoriePc?" Value="c">@c.Libelle()</MudSelectItem> }
                </MudSelect>
            </MudItem>

            <MudItem xs="12"><MudText Typo="Typo.subtitle2" Class="mt-2">Matériel reçu</MudText></MudItem>
            @foreach (var (m, i) in _d.Materiels.Select((m, i) => (m, i)))
            {
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="TypeMateriel" Value="m.Type" ValueChanged="t => ChangerType(m, t)" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var t in Enum.GetValues<TypeMateriel>()) { <MudSelectItem Value="t">@t.Libelle()</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2"><MudTextField T="string" MaxLength="400" Value="m.NumInterne" ValueChanged="v => SaisirNumero(m, v)" Label="@(m.Type is TypeMateriel.PcFixe or TypeMateriel.PcPortable ? "Nom du PC *" : "N° interne")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                  HelperText="@(_proposes.Contains(m) ? "proposé (suite de la numérotation)" : null)" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField MaxLength="400" @bind-Value="m.Modele" Label="Modèle" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudTextField MaxLength="400" @bind-Value="m.NumSerie" Label="N° de série *" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6" md="2"><MudTextField MaxLength="400" @bind-Value="m.NumFacture" Label="N° facture *" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6" md="1" Class="d-flex align-center">
                    <MudTooltip Text="Dupliquer la ligne"><MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="() => Dupliquer(m)" aria-label="Dupliquer" /></MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Disabled="_d.Materiels.Count == 1" OnClick="() => Retirer(i)" aria-label="Supprimer" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" OnClick="AjouterLigne">Ajouter une ligne</MudButton>
                <MudText Typo="Typo.caption" Class="d-block">* obligatoire. Le n° interne suivant de la nomenclature (PC, PO, E, I) est proposé automatiquement ; vous pouvez le modifier.</MudText>
            </MudItem>
            @if (_erreur is not null)
            {
                <MudItem xs="12"><MudAlert Severity="Severity.Error">@_erreur</MudAlert></MudItem>
            }
            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="Valider" Disabled="_envoi">Entrer en stock et générer la fiche</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private DemandeAchat _d = new();
    private ResultatMouvement? _resultat;
    private string? _erreur;
    private bool _envoi;

    // Lignes dont le n° interne a été proposé par l'application (et pas saisi) : recalculées à chaque changement
    private readonly HashSet<NouveauMateriel> _proposes = [];

    protected override Task OnInitializedAsync() => NouvelleReception();

    private async Task NouvelleReception()
    {
        _resultat = null;
        _d = new();
        _proposes.Clear();
        _proposes.Add(_d.Materiels[0]);
        await ProposerNumeros();
    }

    /// <summary>Numéros suivants de la nomenclature pour les lignes proposées, en tenant compte des autres lignes.</summary>
    private async Task ProposerNumeros()
    {
        var reserves = _d.Materiels.Where(x => !_proposes.Contains(x) && !string.IsNullOrWhiteSpace(x.NumInterne))
            .Select(x => x.NumInterne!.Trim().ToUpperInvariant()).ToList();
        foreach (var m in _d.Materiels.Where(_proposes.Contains))
        {
            m.NumInterne = await Service.ProchainNumInterneAsync(m.Type, reserves);
            reserves.Add(m.NumInterne);
        }
    }

    private async Task ChangerType(NouveauMateriel m, TypeMateriel t)
    {
        m.Type = t;
        if (string.IsNullOrWhiteSpace(m.NumInterne)) _proposes.Add(m);
        await ProposerNumeros();
    }

    private async Task SaisirNumero(NouveauMateriel m, string? v)
    {
        m.NumInterne = v;
        if (string.IsNullOrWhiteSpace(v)) _proposes.Add(m); else _proposes.Remove(m);
        await ProposerNumeros();
    }

    private async Task Retirer(int i)
    {
        _proposes.Remove(_d.Materiels[i]);
        _d.Materiels.RemoveAt(i);
        await ProposerNumeros();
    }

    private async Task Dupliquer(NouveauMateriel m)
    {
        var copie = new NouveauMateriel { Type = m.Type, Modele = m.Modele, Configuration = m.Configuration, NumFacture = m.NumFacture };
        _d.Materiels.Add(copie);
        _proposes.Add(copie);
        await ProposerNumeros();
    }

    // Nouvelle ligne : même facture que la précédente (le plus souvent une seule facture par réception)
    private async Task AjouterLigne()
    {
        var precedente = _d.Materiels.LastOrDefault();
        var ligne = new NouveauMateriel { Type = precedente?.Type ?? TypeMateriel.PcPortable, NumFacture = precedente?.NumFacture };
        _d.Materiels.Add(ligne);
        _proposes.Add(ligne);
        await ProposerNumeros();
    }

    private async Task Valider()
    {
        _erreur = null;
        _envoi = true;
        try { _resultat = await Service.ReceptionnerAchatAsync(_d, await Courant.ObtenirAsync()); }
        catch (ErreurMetier ex) { _erreur = ex.Message; }
        finally { _envoi = false; }
    }
}
