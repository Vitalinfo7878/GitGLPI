@page "/mouvements/nouveau"
@attribute [Authorize(Policy = Roles.PolitiqueGestion)]
@inject ServiceComptesMicrosoft ComptesMicrosoft
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject ServiceMouvements Service
@inject UtilisateurCourant Courant
@inject ISnackbar Snackbar
@inject IConfiguration Config

<PageTitle>@Titre</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">@Titre</MudText>

@if (_resultat is not null)
{
    <MudPaper Elevation="0" Class="carte pa-5 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="vertical-align:middle" />
            Mouvement@(_resultat.Numeros.Count > 1 ? "s" : "") n° @string.Join(", ", _resultat.Numeros) enregistré@(_resultat.Numeros.Count > 1 ? "s" : "")
        </MudText>
        @if (_resultat.Fiche is { } f)
        {
            <MudButton Href="@($"/fiches/{f.IdPublic}/pdf")" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PictureAsPdf">Fiche @f.Code</MudButton>
        }
        @if (_resultat.Avertissement is { } a)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">@a</MudAlert>
        }
        <div class="d-flex gap-2 mt-4">
            @if (_materiels.Count == 1)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/materiels/{_materiels[0].Id}")">Retour à la fiche matériel</MudButton>
            }
            <MudButton Variant="@(_materiels.Count == 1 ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" OnClick="Recommencer">Nouveau mouvement</MudButton>
            <MudButton Href="/inventaire" Variant="Variant.Text">Retour à l'inventaire</MudButton>
        </div>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Class="carte pa-4">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="8">
                        <MudSelect T="TypeMouvement" Value="_d.Type" ValueChanged="ChangerType" Label="Type de mouvement" Variant="Variant.Outlined">
                            @foreach (var t in RegleMouvement.TypesSaisissables) { <MudSelectItem Value="t">@t.Libelle()</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Date="@(_d.Date.ToDateTime(TimeOnly.MinValue))" DateChanged="@((DateTime? d) => _d.Date = DateOnly.FromDateTime(d ?? DateTime.Today))"
                                       Label="Date" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                    </MudItem>

                    @if (_d.Type == TypeMouvement.Achat)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Nouveau matériel ? Passez par la <MudLink Href="/achat">réception d'achat</MudLink> : elle crée le matériel et son mouvement « Achat ».
                                Ici, l'achat s'enregistre pour un matériel déjà en stock.
                            </MudAlert>
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Matériel</MudText>
                        <MudAutocomplete T="Materiel" @ref="_recherche" SearchFunc="ChercherMateriel" ValueChanged="AjouterMateriel" ToStringFunc="@(m => m?.NumInterne ?? "")"
                                         Placeholder="Ajouter : n° interne, modèle, n° de série…" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         AdornmentIcon="@Icons.Material.Filled.Search" ResetValueOnEmptyText="true" MinCharacters="2" DebounceInterval="200">
                            <ItemTemplate Context="m">
                                <b>@m.NumInterne</b> · @m.Type.Libelle() · @m.Modele <small>@m.DetenteurLibelle</small> <ChipStatut Statut="m.Statut" />
                            </ItemTemplate>
                        </MudAutocomplete>
                        @foreach (var m in _materiels)
                        {
                            var autorise = _regle.EstAutorisePour(m.Statut);
                            <div class="d-flex align-center gap-2 py-2" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                                <MudIcon Icon="@(autorise ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Block)" Color="@(autorise ? Color.Success : Color.Error)" Size="Size.Small" />
                                <div style="flex:1">
                                    <b>@m.NumInterne</b> · @m.Type.Libelle() · @m.Modele
                                    <div><small>@(string.IsNullOrEmpty(m.DetenteurLibelle) ? "" : $"Actuellement : {m.DetenteurLibelle}")</small></div>
                                    @if (!autorise) { <MudText Typo="Typo.caption" Color="Color.Error">« @_d.Type.Libelle() » impossible : le matériel est « @m.Statut.Libelle() ».</MudText> }
                                </div>
                                <ChipStatut Statut="m.Statut" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => _materiels.Remove(m)" aria-label="Retirer" />
                            </div>
                        }
                    </MudItem>

                    @if (_regle.DestinationEstDetenteur)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Destinataire</MudText>
                            <MudToggleGroup T="string" Value="@(_partage ? "partage" : _typeDest.ToString())" ValueChanged="ChoisirDestination" Color="Color.Primary" Size="Size.Small" Class="mb-2">
                                <MudToggleItem Value="@nameof(TypeDetenteur.Personne)" Text="Personne" />
                                <MudToggleItem Value="@nameof(TypeDetenteur.Site)" Text="Site" />
                                @if (QuePortables || _partage) { <MudToggleItem Value="@("partage")" Text="PC partagé (télétravail)" /> }
                            </MudToggleGroup>
                            @if (_partage)
                            {
                                <MudAutocomplete T="string" @bind-Value="_postePartage" SearchFunc="ChercherPostePartage" CoerceValue="true" MaxLength="200"
                                                 Label="Poste partagé *" Variant="Variant.Outlined" Margin="Margin.Dense" ShowProgressIndicator="false"
                                                 HelperText="PC portable de télétravail qui n'appartient à personne. Un autre nom peut être saisi." />
                            }
                            else if (_typeDest == TypeDetenteur.Site)
                            {
                                <MudAutocomplete T="Site" Value="_site" ValueChanged="ChoisirSite" SearchFunc="ChercherSite" ToStringFunc="@(s => s?.Libelle ?? "")"
                                                 Label="Site (code ou nom)" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="200" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.AddBusiness" OnClick="() => _nouveauSite = !_nouveauSite">Nouveau site</MudButton>
                                @if (_nouveauSite)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-center">
                                        <MudTextField MaxLength="50" @bind-Value="_nsCode" Label="Code du site" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudTextField MaxLength="400" @bind-Value="_nsNom" Label="Nom (facultatif)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudButton Variant="Variant.Outlined" OnClick="CreerSite">Créer</MudButton>
                                    </div>
                                }
                            }
                            else
                            {
                                <MudAutocomplete T="Personne" Value="_personne" ValueChanged="ChoisirPersonne" SearchFunc="ChercherPersonne" ToStringFunc="@(p => p?.NomComplet ?? "")"
                                                 Label="Personne" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="200" />
                                @if (_annuaireDisponible)
                                {
                                    <MudAutocomplete T="CompteMicrosoft" SearchFunc="ChercherCompte" ValueChanged="ChoisirCompte"
                                                     ToStringFunc="@(c => c is null ? "" : $"{c.NomAffichage} · {c.AdressePrincipale}")"
                                                     Label="Ou depuis l'annuaire Microsoft" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                                                     DebounceInterval="250" MinCharacters="2" ResetValueOnEmptyText="true" />
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.PersonAdd" OnClick="() => _nouvellePersonne = !_nouvellePersonne">Nouvelle personne</MudButton>
                                @if (_nouvellePersonne)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-center">
                                        <MudTextField MaxLength="400" @bind-Value="_npNom" Label="Prénom NOM" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudTextField MaxLength="400" @bind-Value="_npEmail" Label="Adresse mail *" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" />
                                        <MudButton Variant="Variant.Outlined" OnClick="CreerPersonne">Créer</MudButton>
                                    </div>
                                }
                            }
                            @if (!_partage)
                            {
                                <MudTextField @bind-Value="_d.EmailDetenteur" MaxLength="200" Label="Adresse mail du destinataire *" InputType="InputType.Email"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                                              HelperText="Obligatoire : enregistrée sur la personne ou le site, elle donne accès à « Mon matériel »." />
                            }
                        </MudItem>
                        @if (ChangementDetenteur)
                        {
                            <MudItem xs="12">
                                <MudSwitch T="bool" @bind-Value="_d.Correction" Color="Color.Warning" Label="Correction du détenteur, sans fiche" />
                                <MudText Typo="Typo.caption" Class="d-block">
                                    Pour corriger une erreur de saisie ou d'import : le changement reste tracé dans l'historique du matériel, mais aucune fiche FIA n'est générée.
                                </MudText>
                            </MudItem>
                        }
                    }
                    else
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField MaxLength="400" @bind-Value="_d.DestinationLibre" Label="@LibelleDestinationLibre" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                    @if (_d.Type == TypeMouvement.Restitution && _materiels.Any(m => !string.IsNullOrWhiteSpace(m.ProfilMicrosoft)))
                    {
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="_d.EffacerProfilMicrosoft" Color="Color.Primary" Dense="true"
                                         Label="@($"Effacer le profil Microsoft du PC ({string.Join(", ", _materiels.Where(m => !string.IsNullOrWhiteSpace(m.ProfilMicrosoft)).Select(m => m.ProfilMicrosoft))})")" />
                            <MudText Typo="Typo.caption" Class="d-block ml-8">L'ancien détenteur reste dans l'historique du matériel.</MudText>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudTextField MaxLength="400" @bind-Value="_d.Expediteur" Label="Expéditeur" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@(_d.Type == TypeMouvement.Restitution ? "Vide = détenteur actuel" : null)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField MaxLength="400" @bind-Value="_d.DocumentReference" Label="Document de référence (devis, bon, fiche retour…)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_d.Commentaire" MaxLength="2000" Label="@(_d.Type == TypeMouvement.MiseAuRebut ? "Raison de la mise au rebut" : "Commentaire")" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    @if (_erreur is not null)
                    {
                        <MudItem xs="12"><MudAlert Severity="Severity.Error">@_erreur</MudAlert></MudItem>
                    }
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="Valider" Disabled="@(_envoi || _materiels.Count == 0)">
                            @(Correction ? "Enregistrer la correction" : _regle.Fiche is not null ? "Enregistrer et générer la fiche" : "Enregistrer")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Elevation="0" Class="carte pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@_d.Type.Libelle()</MudText>
                <MudText Typo="Typo.body2">Après ce mouvement, le matériel passera au statut <ChipStatut Statut="_regle.StatutResultant" />.</MudText>
                @if (Correction)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">Correction : aucune fiche ne sera générée ; le mouvement est noté « @ServiceMouvements.MentionCorrection » dans l'historique.</MudText>
                }
                else if (_regle.Fiche is { } tf)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">Une <b>@tf.Libelle().ToLowerInvariant()</b> (@RegleMouvement.PrefixeFiche(tf)) sera générée en PDF et conservée.</MudText>
                }
                <MudText Typo="Typo.body2" Class="mt-2">Possible depuis : @string.Join(", ", _regle.StatutsAutorises.Select(s => s.Libelle()))</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [SupplyParameterFromQuery(Name = "ids")] public string? Ids { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "correction")] public bool CorrectionQuery { get; set; }

    private DemandeMouvement _d = new();
    private RegleMouvement _regle = RegleMouvement.Pour(TypeMouvement.Attribution);
    private List<Materiel> _materiels = [];
    private MudAutocomplete<Materiel>? _recherche;
    private TypeDetenteur _typeDest = TypeDetenteur.Personne;
    /// <summary>Destination « PC partagé (télétravail) » : poste partagé, sans adresse mail.</summary>
    private bool _partage;
    private string? _postePartage;
    private List<string> _postesPartages = [];
    private bool QuePortables => _materiels.Count > 0 && _materiels.All(m => m.Type == TypeMateriel.PcPortable);
    private Site? _site;
    private Personne? _personne;
    private bool _nouvellePersonne;
    private string? _npNom, _npEmail;
    private bool _nouveauSite;
    private bool _annuaireDisponible;
    private string? _nsCode, _nsNom;
    private string? _erreur;
    private bool _envoi;
    private ResultatMouvement? _resultat;

    /// <summary>Attribution d'un matériel déjà attribué : passage direct de l'ancien au nouveau détenteur.</summary>
    private bool ChangementDetenteur => _d.Type == TypeMouvement.Attribution && _materiels.Count > 0 && _materiels.All(m => m.Statut == StatutMateriel.Attribue);
    private bool Correction => _d.Correction && ChangementDetenteur;
    private string Titre => _resultat is not null || !ChangementDetenteur ? "Nouveau mouvement" : Correction ? "Corriger le détenteur" : "Changer de détenteur";

    private string LibelleDestinationLibre => _d.Type == TypeMouvement.Achat ? "Destination (stock)" : "Destination";

    protected override async Task OnInitializedAsync()
    {
        await using (var dbAnnuaire = await DbFactory.CreateDbContextAsync())
            _annuaireDisponible = await dbAnnuaire.ComptesMicrosoft.AnyAsync();
        _postesPartages = await Service.PostesPartagesAsync(Config.GetSection("Parc:PostesPartages").Get<string[]>() ?? []);
        if (Enum.TryParse<TypeMouvement>(TypeQuery, out var t) && RegleMouvement.TypesSaisissables.Contains(t)) ChangerType(t);
        else ChangerType(TypeMouvement.Attribution);
        var ids = (Ids ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => int.TryParse(s, out var i) ? i : 0).Where(i => i > 0).ToList();
        if (ids.Count > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _materiels = await db.Materiels.AsNoTracking().Include(m => m.Site).Include(m => m.Personne)
                .Where(m => ids.Contains(m.Id)).OrderBy(m => m.NumInterne).ToListAsync();
            // Type proposé selon le statut du premier matériel
            if (TypeQuery is null && _materiels.Count > 0 && _materiels.All(m => m.Statut == StatutMateriel.Attribue))
                ChangerType(TypeMouvement.Restitution);
            // Changement de détenteur : l'expéditeur est le détenteur actuel
            if (ChangementDetenteur && _materiels.Select(m => m.DetenteurLibelle).Distinct().ToList() is [{ Length: > 0 } detenteur])
                _d.Expediteur = detenteur;
            _d.Correction = CorrectionQuery;
        }
    }

    private void ChangerType(TypeMouvement t)
    {
        _d.Type = t;
        _regle = RegleMouvement.Pour(t);
        _d.Expediteur = _regle.ExpediteurParDefaut;
        _d.DestinationLibre = _regle.DestinationParDefaut;
        _erreur = null;
    }

    private void ChoisirDestination(string valeur)
    {
        _partage = valeur == "partage";
        _d.EmailDetenteur = null;
        if (!_partage) ChangerTypeDest(Enum.Parse<TypeDetenteur>(valeur));
    }

    private Task<IEnumerable<string>> ChercherPostePartage(string? texte, CancellationToken ct) => Task.FromResult(
        _postesPartages.Where(p => string.IsNullOrWhiteSpace(texte) || p.Contains(texte.Trim(), StringComparison.OrdinalIgnoreCase)));

    private void ChangerTypeDest(TypeDetenteur t)
    {
        _typeDest = t;
        _site = null;
        _personne = null;
        _d.EmailDetenteur = null;
    }

    private void ChoisirSite(Site? s)
    {
        _site = s;
        _d.EmailDetenteur = s?.Email;
    }

    private void ChoisirPersonne(Personne? p)
    {
        _personne = p;
        _d.EmailDetenteur = p?.Email;
    }

    private async Task<IEnumerable<Materiel>> ChercherMateriel(string? texte, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texte)) return [];
        var t = Recherche.Texte(texte);
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        return await db.Materiels.AsNoTracking().Include(m => m.Site).Include(m => m.Personne)
            .Where(m => m.NumInterne.ToLower().Contains(t) || (m.NumSerie != null && m.NumSerie.ToLower().Contains(t)) || (m.Modele != null && m.Modele.ToLower().Contains(t)))
            .OrderBy(m => m.NumInterne).Take(20).ToListAsync(ct);
    }

    private async Task AjouterMateriel(Materiel? m)
    {
        if (m is not null && _materiels.All(x => x.Id != m.Id)) _materiels.Add(m);
        if (_recherche is not null) await _recherche.ClearAsync();
    }

    private async Task<IEnumerable<Site>> ChercherSite(string? texte, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var q = db.Sites.AsNoTracking().Where(s => s.Actif);
        if (!string.IsNullOrWhiteSpace(texte))
        {
            var t = Recherche.Texte(texte);
            q = q.Where(s => s.Code.ToLower().Contains(t) || (s.Nom != null && s.Nom.ToLower().Contains(t)));
        }
        return await q.OrderBy(s => s.Code).Take(30).ToListAsync(ct);
    }

    private async Task<IEnumerable<Personne>> ChercherPersonne(string? texte, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var q = db.Personnes.AsNoTracking().Where(p => p.Actif);
        if (!string.IsNullOrWhiteSpace(texte))
        {
            var t = Recherche.Texte(texte);
            q = q.Where(p => p.NomComplet.ToLower().Contains(t) || (p.Email != null && p.Email.ToLower().Contains(t)));
        }
        return await q.OrderBy(p => p.NomComplet).Take(30).ToListAsync(ct);
    }

    private async Task CreerPersonne()
    {
        if (string.IsNullOrWhiteSpace(_npNom) || string.IsNullOrWhiteSpace(_npEmail))
        {
            Snackbar.Add("Nom et adresse mail obligatoires.", Severity.Warning);
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = new Personne { NomComplet = _npNom.Trim(), Email = string.IsNullOrWhiteSpace(_npEmail) ? null : _npEmail.Trim().ToLowerInvariant() };
        db.Personnes.Add(p);
        await db.SaveChangesAsync();
        ChoisirPersonne(p);
        _nouvellePersonne = false;
        _npNom = _npEmail = null;
    }

    private Task<IEnumerable<CompteMicrosoft>> ChercherCompte(string? texte, CancellationToken ct) =>
        ComptesMicrosoft.ChercherComptesAsync(texte, ct).ContinueWith(t => (IEnumerable<CompteMicrosoft>)t.Result, ct);

    /// <summary>Personne choisie dans l'annuaire : retrouvée, ou créée avec son nom et son adresse Microsoft.</summary>
    private async Task ChoisirCompte(CompteMicrosoft? c)
    {
        if (c is null) return;
        try { ChoisirPersonne(await ComptesMicrosoft.PersonnePourCompteAsync(c.Id)); }
        catch (ErreurMetier ex) { Snackbar.Add(ex.Message, Severity.Warning); }
    }

    private async Task CreerSite()
    {
        if (string.IsNullOrWhiteSpace(_nsCode)) return;
        var code = _nsCode.Replace(" ", "").ToUpperInvariant();
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.Sites.FirstOrDefaultAsync(x => x.Code == code);
        if (s is null)
        {
            s = new Site { Code = code, Nom = string.IsNullOrWhiteSpace(_nsNom) ? null : _nsNom.Trim() };
            db.Sites.Add(s);
            await db.SaveChangesAsync();
        }
        ChoisirSite(s);
        _nouveauSite = false;
        _nsCode = _nsNom = null;
    }

    private async Task Valider()
    {
        _erreur = null;
        _envoi = true;
        try
        {
            _d.MaterielIds = _materiels.Select(m => m.Id).ToList();
            _d.Correction = Correction;
            _d.DestinationSiteId = _regle.DestinationEstDetenteur && !_partage && _typeDest == TypeDetenteur.Site ? _site?.Id : null;
            _d.DestinationPersonneId = _regle.DestinationEstDetenteur && !_partage && _typeDest == TypeDetenteur.Personne ? _personne?.Id : null;
            if (_regle.DestinationEstDetenteur && _partage)
            {
                if (!QuePortables) throw new ErreurMetier("Un poste partagé (télétravail) ne reçoit que des PC portables.");
                _d.DestinationPersonneId = (await Service.PostePartageAsync(_postePartage)).Id;
                _d.EmailDetenteur = null;
            }
            _resultat = await Service.CreerMouvementsAsync(_d, await Courant.ObtenirAsync());
        }
        catch (ErreurMetier ex) { _erreur = ex.Message; }
        catch (Exception ex) { _erreur = ex.Message; Snackbar.Add("Erreur lors de l'enregistrement.", Severity.Error); }
        finally { _envoi = false; }
    }

    private void Recommencer()
    {
        _resultat = null;
        _materiels = [];
        _partage = false;
        _postePartage = null;
        _site = null;
        _personne = null;
        _d = new DemandeMouvement();
        ChangerType(TypeMouvement.Attribution);
    }
}
