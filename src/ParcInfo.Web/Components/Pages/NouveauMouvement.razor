@page "/mouvements/nouveau"
@attribute [Authorize(Policy = Roles.PolitiqueGestion)]
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject ServiceMouvements Service
@inject UtilisateurCourant Courant
@inject ISnackbar Snackbar

<PageTitle>Nouveau mouvement</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Nouveau mouvement</MudText>

@if (_resultat is not null)
{
    <MudPaper Elevation="0" Class="carte pa-5 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="vertical-align:middle" />
            Mouvement@(_resultat.Numeros.Count > 1 ? "s" : "") n° @string.Join(", ", _resultat.Numeros) enregistré@(_resultat.Numeros.Count > 1 ? "s" : "")
        </MudText>
        @if (_resultat.Fiche is { } f)
        {
            <div class="d-flex flex-wrap align-center gap-3">
                <MudButton Href="@($"/fiches/{f.IdPublic}/pdf")" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PictureAsPdf">Fiche @f.Code</MudButton>
                <ChipReception Statut="f.StatutReception" />
            </div>
            @if (f.StatutReception == StatutReception.EnAttente && _resultat.AvertissementCourriel is null)
            {
                <MudText Typo="Typo.body2" Class="mt-2">Un courriel a été envoyé à <b>@f.DestinataireEmail</b> pour confirmer la réception.</MudText>
            }
        }
        @if (_resultat.AvertissementCourriel is { } a)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">@a</MudAlert>
        }
        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Recommencer">Nouveau mouvement</MudButton>
            <MudButton Href="/inventaire" Variant="Variant.Text">Retour à l'inventaire</MudButton>
        </div>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="0" Class="carte pa-4">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="8">
                        <MudSelect T="TypeMouvement" Value="_d.Type" ValueChanged="ChangerType" Label="Type de mouvement" Variant="Variant.Outlined">
                            @foreach (var t in RegleMouvement.TypesSaisissables) { <MudSelectItem Value="t">@t.Libelle()</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Date="@(_d.Date.ToDateTime(TimeOnly.MinValue))" DateChanged="@((DateTime? d) => _d.Date = DateOnly.FromDateTime(d ?? DateTime.Today))"
                                       Label="Date" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Matériel</MudText>
                        <MudAutocomplete T="Materiel" @ref="_recherche" SearchFunc="ChercherMateriel" ValueChanged="AjouterMateriel" ToStringFunc="@(m => m?.NumInterne ?? "")"
                                         Placeholder="Ajouter : n° interne, modèle, n° de série…" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         AdornmentIcon="@Icons.Material.Filled.Search" ResetValueOnEmptyText="true" MinCharacters="2" DebounceInterval="200">
                            <ItemTemplate Context="m">
                                <b>@m.NumInterne</b> · @m.Type.Libelle() · @m.Modele <small>@m.DetenteurLibelle</small> <ChipStatut Statut="m.Statut" />
                            </ItemTemplate>
                        </MudAutocomplete>
                        @foreach (var m in _materiels)
                        {
                            var autorise = _regle.EstAutorisePour(m.Statut);
                            <div class="d-flex align-center gap-2 py-2" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                                <MudIcon Icon="@(autorise ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Block)" Color="@(autorise ? Color.Success : Color.Error)" Size="Size.Small" />
                                <div style="flex:1">
                                    <b>@m.NumInterne</b> · @m.Type.Libelle() · @m.Modele
                                    <div><small>@(string.IsNullOrEmpty(m.DetenteurLibelle) ? "" : $"Actuellement : {m.DetenteurLibelle}")</small></div>
                                    @if (!autorise) { <MudText Typo="Typo.caption" Color="Color.Error">« @_d.Type.Libelle() » impossible : le matériel est « @m.Statut.Libelle() ».</MudText> }
                                </div>
                                <ChipStatut Statut="m.Statut" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => _materiels.Remove(m)" aria-label="Retirer" />
                            </div>
                        }
                    </MudItem>

                    @if (_regle.DestinationEstDetenteur)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Destinataire</MudText>
                            <MudToggleGroup T="TypeDetenteur" Value="_typeDest" ValueChanged="ChangerTypeDest" Color="Color.Primary" Size="Size.Small" Class="mb-2">
                                <MudToggleItem Value="TypeDetenteur.Personne" Text="Personne" />
                                <MudToggleItem Value="TypeDetenteur.Site" Text="Site" />
                            </MudToggleGroup>
                            @if (_typeDest == TypeDetenteur.Site)
                            {
                                <MudAutocomplete T="Site" Value="_site" ValueChanged="ChoisirSite" SearchFunc="ChercherSite" ToStringFunc="@(s => s?.Libelle ?? "")"
                                                 Label="Site (code ou nom)" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="200" />
                            }
                            else
                            {
                                <MudAutocomplete T="Personne" Value="_personne" ValueChanged="ChoisirPersonne" SearchFunc="ChercherPersonne" ToStringFunc="@(p => p?.NomComplet ?? "")"
                                                 Label="Personne" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="200" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.PersonAdd" OnClick="() => _nouvellePersonne = !_nouvellePersonne">Nouvelle personne</MudButton>
                                @if (_nouvellePersonne)
                                {
                                    <div class="d-flex flex-wrap gap-2 align-center">
                                        <MudTextField @bind-Value="_npNom" Label="Prénom NOM" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudTextField @bind-Value="_npEmail" Label="Adresse mail" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudButton Variant="Variant.Outlined" OnClick="CreerPersonne">Créer</MudButton>
                                    </div>
                                }
                            }
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_d.DestinationLibre" Label="@LibelleDestinationLibre" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_d.Expediteur" Label="Expéditeur" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@(_d.Type == TypeMouvement.Restitution ? "Vide = détenteur actuel" : null)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_d.DocumentReference" Label="Document de référence (devis, bon, fiche retour…)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_d.Commentaire" Label="@(_d.Type == TypeMouvement.MiseAuRebut ? "Raison de la mise au rebut" : "Commentaire")" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    @if (_d.Type == TypeMouvement.Attribution)
                    {
                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="_d.DemanderConfirmation" Label="Demander au destinataire de confirmer la réception par mail" />
                            @if (_d.DemanderConfirmation)
                            {
                                <MudTextField @bind-Value="_d.EmailDestinataire" Label="Adresse mail du destinataire" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              HelperText="Le destinataire recevra un lien ; le mot de passe de session s'affichera après sa confirmation." />
                            }
                        </MudItem>
                    }

                    @if (_erreur is not null)
                    {
                        <MudItem xs="12"><MudAlert Severity="Severity.Error">@_erreur</MudAlert></MudItem>
                    }
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="Valider" Disabled="@(_envoi || _materiels.Count == 0)">
                            Enregistrer @(_regle.Fiche is not null ? "et générer la fiche" : "")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="5">
            <MudPaper Elevation="0" Class="carte pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@_d.Type.Libelle()</MudText>
                <MudText Typo="Typo.body2">Après ce mouvement, le matériel passera au statut <ChipStatut Statut="_regle.StatutResultant" />.</MudText>
                @if (_regle.Fiche is { } tf)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">Une <b>@tf.Libelle().ToLowerInvariant()</b> (@RegleMouvement.PrefixeFiche(tf)) sera générée en PDF et conservée.</MudText>
                }
                <MudText Typo="Typo.body2" Class="mt-2">Possible depuis : @string.Join(", ", _regle.StatutsAutorises.Select(s => s.Libelle()))</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [SupplyParameterFromQuery(Name = "ids")] public string? Ids { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeQuery { get; set; }

    private DemandeMouvement _d = new();
    private RegleMouvement _regle = RegleMouvement.Pour(TypeMouvement.Attribution);
    private List<Materiel> _materiels = [];
    private MudAutocomplete<Materiel>? _recherche;
    private TypeDetenteur _typeDest = TypeDetenteur.Personne;
    private Site? _site;
    private Personne? _personne;
    private bool _nouvellePersonne;
    private string? _npNom, _npEmail;
    private string? _erreur;
    private bool _envoi;
    private ResultatMouvement? _resultat;

    private string LibelleDestinationLibre => _d.Type is TypeMouvement.EnvoiReparation or TypeMouvement.RenvoiFournisseur
        ? "Fournisseur / réparateur" : "Destination";

    protected override async Task OnInitializedAsync()
    {
        if (Enum.TryParse<TypeMouvement>(TypeQuery, out var t) && RegleMouvement.TypesSaisissables.Contains(t)) ChangerType(t);
        else ChangerType(TypeMouvement.Attribution);
        var ids = (Ids ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => int.TryParse(s, out var i) ? i : 0).Where(i => i > 0).ToList();
        if (ids.Count > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _materiels = await db.Materiels.AsNoTracking().Include(m => m.Site).Include(m => m.Personne)
                .Where(m => ids.Contains(m.Id)).OrderBy(m => m.NumInterne).ToListAsync();
            // Type proposé selon le statut du premier matériel
            if (TypeQuery is null && _materiels.Count > 0 && _materiels.All(m => m.Statut == StatutMateriel.Attribue))
                ChangerType(TypeMouvement.Restitution);
        }
    }

    private void ChangerType(TypeMouvement t)
    {
        _d.Type = t;
        _regle = RegleMouvement.Pour(t);
        _d.Expediteur = _regle.ExpediteurParDefaut;
        _d.DestinationLibre = _regle.DestinationParDefaut;
        _erreur = null;
    }

    private void ChangerTypeDest(TypeDetenteur t)
    {
        _typeDest = t;
        _site = null;
        _personne = null;
        _d.EmailDestinataire = null;
    }

    private void ChoisirSite(Site? s)
    {
        _site = s;
        _d.EmailDestinataire = s?.Email;
    }

    private void ChoisirPersonne(Personne? p)
    {
        _personne = p;
        _d.EmailDestinataire = p?.Email;
    }

    private async Task<IEnumerable<Materiel>> ChercherMateriel(string? texte, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texte)) return [];
        var t = Recherche.Motif(texte);
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        return await db.Materiels.AsNoTracking().Include(m => m.Site).Include(m => m.Personne)
            .Where(m => EF.Functions.Like(m.NumInterne, t) || EF.Functions.Like(m.NumSerie, t) || EF.Functions.Like(m.Modele, t))
            .OrderBy(m => m.NumInterne).Take(20).ToListAsync(ct);
    }

    private async Task AjouterMateriel(Materiel? m)
    {
        if (m is not null && _materiels.All(x => x.Id != m.Id)) _materiels.Add(m);
        if (_recherche is not null) await _recherche.ClearAsync();
    }

    private async Task<IEnumerable<Site>> ChercherSite(string? texte, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var q = db.Sites.AsNoTracking().Where(s => s.Actif);
        if (!string.IsNullOrWhiteSpace(texte)) q = q.Where(s => EF.Functions.Like(s.Code, Recherche.Motif(texte)) || EF.Functions.Like(s.Nom, Recherche.Motif(texte)));
        return await q.OrderBy(s => s.Code).Take(30).ToListAsync(ct);
    }

    private async Task<IEnumerable<Personne>> ChercherPersonne(string? texte, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var q = db.Personnes.AsNoTracking().Where(p => p.Actif);
        if (!string.IsNullOrWhiteSpace(texte)) q = q.Where(p => EF.Functions.Like(p.NomComplet, Recherche.Motif(texte)) || EF.Functions.Like(p.Email, Recherche.Motif(texte)));
        return await q.OrderBy(p => p.NomComplet).Take(30).ToListAsync(ct);
    }

    private async Task CreerPersonne()
    {
        if (string.IsNullOrWhiteSpace(_npNom)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = new Personne { NomComplet = _npNom.Trim(), Email = string.IsNullOrWhiteSpace(_npEmail) ? null : _npEmail.Trim().ToLowerInvariant() };
        db.Personnes.Add(p);
        await db.SaveChangesAsync();
        ChoisirPersonne(p);
        _nouvellePersonne = false;
        _npNom = _npEmail = null;
    }

    private async Task Valider()
    {
        _erreur = null;
        _envoi = true;
        try
        {
            _d.MaterielIds = _materiels.Select(m => m.Id).ToList();
            _d.DestinationSiteId = _regle.DestinationEstDetenteur && _typeDest == TypeDetenteur.Site ? _site?.Id : null;
            _d.DestinationPersonneId = _regle.DestinationEstDetenteur && _typeDest == TypeDetenteur.Personne ? _personne?.Id : null;
            _resultat = await Service.CreerMouvementsAsync(_d, await Courant.ObtenirAsync());
        }
        catch (ErreurMetier ex) { _erreur = ex.Message; }
        catch (Exception ex) { _erreur = ex.Message; Snackbar.Add("Erreur lors de l'enregistrement.", Severity.Error); }
        finally { _envoi = false; }
    }

    private void Recommencer()
    {
        _resultat = null;
        _materiels = [];
        _site = null;
        _personne = null;
        _d = new DemandeMouvement();
        ChangerType(TypeMouvement.Attribution);
    }
}
