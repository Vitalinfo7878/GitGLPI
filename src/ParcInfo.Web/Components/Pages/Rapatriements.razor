@page "/rapatriements"
@attribute [Authorize(Policy = Roles.PolitiqueTickets)]
@inject IDbContextFactory<ParcDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Rapatriements</PageTitle>
<MudText Typo="Typo.h4" Class="mb-1">Rapatriements de matériel</MudText>
<MudText Class="mb-4" Style="color:var(--mud-palette-text-secondary)">
    Ancien matériel à récupérer après une demande de remplacement. Ces tickets internes au service informatique sont séparés des tickets d'assistance
    et ne sont pas visibles des demandeurs.
</MudText>

@if (_tickets is null)
{
    <Attente />
}
else
{
    <MudPaper Elevation="0" Class="carte pa-3 mb-3">
        <div class="d-flex flex-wrap align-center gap-3">
            <MudToggleGroup T="string" @bind-Value="_vue" Color="Color.Primary" Size="Size.Small">
                <MudToggleItem Value="@("encours")" Text="@($"En cours ({_tickets.Count(t => t.EstOuvert)})")" />
                <MudToggleItem Value="@("termines")" Text="@($"Terminés ({_tickets.Count(t => !t.EstOuvert)})")" />
                <MudToggleItem Value="@("tous")" Text="@($"Tous ({_tickets.Count})")" />
            </MudToggleGroup>
            <MudTextField T="string" @bind-Value="_recherche" Immediate="true" DebounceInterval="250" Placeholder="N°, matériel, demande, demandeur, adresse…"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                          Style="min-width:260px" />
        </div>
    </MudPaper>

    <MudDataGrid T="Ticket" Breakpoint="Breakpoint.None" Items="Filtres" Dense="true" Hover="true" Elevation="0" Class="carte" RowsPerPage="50" RowClick="Ouvrir" RowClass="lien-ligne" HorizontalScrollbar="true">
        <Columns>
            <PropertyColumn Property="x => x.Numero" Title="N°" CellStyle="font-weight:600" />
            <TemplateColumn T="Ticket" Title="Créé le" HeaderClass="mobile-cache" CellClass="mobile-cache" SortBy="x => x.CreeLe"><CellTemplate>@context.Item.CreeLe.ToLocalTime().ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
            <TemplateColumn T="Ticket" Title="Ancien matériel" SortBy="x => x.MaterielReference">
                <CellTemplate>
                    @if (context.Item.Materiel is { } m)
                    {
                        <b>@m.NumInterne</b> <small>@m.Type.Libelle() @m.Modele</small>
                    }
                    else if (context.Item.MaterielReference is { } r) { <b>@r</b> }
                    else { <span style="color:var(--mud-palette-warning)">À identifier</span> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="Ticket" Title="Demande" SortBy="x => x.Demande == null ? 0 : x.Demande.Numero">
                <CellTemplate>
                    @if (context.Item.Demande is { } d)
                    {
                        <span @onclick:stopPropagation="true"><MudLink Href="@($"/demandes/{d.IdPublic}")">n° @d.Numero</MudLink></span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.DemandeurNom" Title="Demandeur" HeaderClass="mobile-cache" CellClass="mobile-cache" />
            <PropertyColumn Property="x => x.Lieu" Title="Adresse" HeaderClass="mobile-cache" CellClass="mobile-cache" />
            <PropertyColumn Property="x => x.AssigneA" Title="Pris en charge par" HeaderClass="mobile-cache" CellClass="mobile-cache" />
            <TemplateColumn T="Ticket" Title="Statut" SortBy="x => x.Statut"><CellTemplate><ChipTicket Statut="context.Item.Statut" /></CellTemplate></TemplateColumn>
            <TemplateColumn T="Ticket" Title="Depuis" SortBy="x => x.CreeLe">
                <CellTemplate>@(context.Item.EstOuvert ? Duree.Texte(DateTime.UtcNow - context.Item.CreeLe) : "")</CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Ticket" PageSizeOptions="[25, 50, 100]" RowsPerPageString="Lignes par page :" InfoFormat="{first_item}-{last_item} sur {all_items}" />
        </PagerContent>
        <NoRecordsContent><MudText>Aucun rapatriement.</MudText></NoRecordsContent>
    </MudDataGrid>
}

@code {
    private List<Ticket>? _tickets;
    private string _vue = "encours";
    private string? _recherche;

    private IEnumerable<Ticket> Filtres => (_vue switch
        {
            "encours" => _tickets!.Where(t => t.EstOuvert),
            "termines" => _tickets!.Where(t => !t.EstOuvert),
            _ => _tickets!,
        })
        .Where(t => string.IsNullOrWhiteSpace(_recherche)
            || $"{t.Numero} {t.Titre} {t.MaterielReference} {t.Materiel?.NumInterne} {t.Materiel?.Modele} {t.Demande?.Numero} {t.DemandeurNom} {t.DemandeurEmail} {t.Lieu} {t.AssigneA}"
                .Contains(_recherche.Trim(), StringComparison.OrdinalIgnoreCase))
        // En cours : les plus anciens d'abord (à récupérer en priorité) ; terminés : les plus récents d'abord
        .OrderByDescending(t => t.EstOuvert).ThenBy(t => t.EstOuvert ? t.Numero : -t.Numero);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _tickets = await db.Tickets.AsNoTracking().Include(t => t.Materiel).Include(t => t.Demande)
            .Where(t => t.Interne).OrderBy(t => t.Numero).ToListAsync();
        if (!_tickets.Any(t => t.EstOuvert)) _vue = "tous";
    }

    private void Ouvrir(DataGridRowClickEventArgs<Ticket> e) => Nav.NavigateTo($"/tickets/{e.Item.Id}");
}
