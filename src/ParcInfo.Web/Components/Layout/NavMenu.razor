<MudNavMenu Class="pt-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Accueil</MudNavLink>
    <AuthorizeView Policy="@Roles.PolitiqueSalarie">
        <MudNavLink Href="/mon-materiel" Icon="@Icons.Material.Outlined.Person">Mon matériel</MudNavLink>
        <MudNavLink Href="/demandes/nouvelle" Icon="@Icons.Material.Outlined.AddShoppingCart">Faire une demande</MudNavLink>
        <MudNavLink Href="/mes-demandes" Icon="@Icons.Material.Outlined.ListAlt">Mes demandes</MudNavLink>
    </AuthorizeView>
    <MudNavLink Href="/tickets/nouveau" Icon="@Icons.Material.Outlined.ReportProblem">Créer un ticket</MudNavLink>
    <MudNavLink Href="/mes-tickets" Icon="@Icons.Material.Outlined.SupportAgent">Mes tickets</MudNavLink>
    <AuthorizeView Policy="@Roles.PolitiqueTickets">
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="px-4 menu-section">Tickets</MudText>
        <MudNavLink Href="/tickets" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ConfirmationNumber">Tickets à traiter</MudNavLink>
        <MudNavLink Href="/tickets/analyse" Icon="@Icons.Material.Outlined.Insights">Analyse des tickets</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@Roles.PolitiqueValidation">
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="px-4 menu-section">Demandes</MudText>
        <MudNavLink Href="/demandes" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.FactCheck">Demandes à valider / traiter</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@Roles.PolitiqueGestion">
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="px-4 menu-section">Gestion du parc</MudText>
        <MudNavLink Href="/inventaire" Icon="@Icons.Material.Outlined.Inventory2">Inventaire</MudNavLink>
        <MudNavLink Href="/mouvements" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SwapHoriz">Mouvements</MudNavLink>
        <MudNavLink Href="/mouvements/nouveau" Icon="@Icons.Material.Outlined.AddCircleOutline">Nouveau mouvement</MudNavLink>
        <MudNavLink Href="/achat" Icon="@Icons.Material.Outlined.LocalShipping">Réception d'achat</MudNavLink>
        <MudNavLink Href="/fiches" Icon="@Icons.Material.Outlined.Description">Fiches</MudNavLink>
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="px-4 menu-section">Administration</MudText>
        <MudNavLink Href="/import" Icon="@Icons.Material.Outlined.UploadFile">Import Excel</MudNavLink>
        <MudNavLink Href="/comptes-microsoft" Icon="@Icons.Material.Outlined.ManageAccounts">Comptes Microsoft</MudNavLink>
        <MudNavLink Href="/doublons" Icon="@Icons.Material.Outlined.ContentCopy">Doublons</MudNavLink>
        <MudNavLink Href="/courriels" Icon="@Icons.Material.Outlined.Email">Courriels envoyés</MudNavLink>
        <MudNavLink Href="/journal" Icon="@Icons.Material.Outlined.History">Journal</MudNavLink>
    </AuthorizeView>
</MudNavMenu>
